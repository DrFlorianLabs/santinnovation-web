# Production: secret aléatoire >= 32 caractères dans l'environnement serveur uniquement.
# Local: npm run init génère cms/.local/secret (permissions 0600).
PAYLOAD_SECRET=
CMS_SERVER_URL=http://127.0.0.1:3001
# Valeur absolue recommandée sur le serveur; base et images hors racine web.
CMS_DATA_DIR=
