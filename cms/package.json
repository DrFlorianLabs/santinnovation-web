{
  "name": "santinnovation-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "check": "tsc --noEmit",
    "init": "node --import tsx scripts/init.ts",
    "test": "node --import tsx scripts/test.ts",
    "test:account-ui": "node --import tsx scripts/test-account-ui.ts",
    "export": "node --import tsx scripts/export.ts",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status"
  },
  "dependencies": {
    "@libsql/client": "0.14.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "drizzle-orm": "0.45.2",
    "graphql": "16.13.1",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sass": "1.105.1",
    "undici": "7.29.1",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2"
  }
}
