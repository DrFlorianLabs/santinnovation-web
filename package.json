{
  "name": "santinnovation-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Site public des Maisons de Santé Pluriprofessionnelles Sant'Innovation (Besançon).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "publish:local": "node scripts/release.mjs",
    "publication:watch": "node scripts/watch-publication.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "verify": "npm run test:unit && npm run check && npm run publish:local",
    "test:admin-ui": "node tests/admin-ui.mjs",
    "test:publication": "node tests/cms-publication.mjs",
    "test:worker": "node tests/worker.mjs",
    "build:prototype": "node scripts/build-prototype.mjs",
    "test:prototype": "node tests/prototype.mjs",
    "rollback": "node scripts/rollback.mjs",
    "releases:prune": "node scripts/releases-prune.mjs",
    "test:publication-robustness": "node --test tests/publication-robustness.test.mjs",
    "backup": "node ops/backup.mjs",
    "restore": "node ops/restore.mjs",
    "test:prototype-browser": "node tests/prototype-browser.mjs",
    "test:dashboard": "node tests/publication-dashboard.mjs",
    "test:publication-status-ui": "node tests/publication-robustness-ui.mjs",
    "backups:rotate": "node ops/rotate-backups.mjs",
    "health": "node ops/check-health.mjs",
    "test:ops": "node --test tests/ops*.test.mjs",
    "scan:public": "node scripts/scan-public.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/sora": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.6",
    "leaflet": "^1.9.4",
    "sanitize-html": "2.18.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/leaflet": "^1.9.12",
    "@types/sanitize-html": "2.16.2",
    "typescript": "^5.7.0"
  }
}
