---
import Icon from "./Icon.astro";

/** Bloc « contenu en préparation » pour les pages en attente de contenu validé. */
interface Props {
  message?: string;
}
const {
  message = "Le contenu de cette page est en cours de rédaction par l'équipe. Il sera publié après validation.",
} = Astro.props;
---

<div class="container-site py-14">
  <div class="surface mx-auto max-w-2xl p-8 text-center">
    <span
      class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-b from-teal-100 to-teal-500/20 text-teal-600 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)]"
    >
      <Icon name="file-text" size={24} />
    </span>
    <h2 class="mt-4 font-display text-xl font-semibold text-blue-900">Contenu en préparation</h2>
    <p class="mt-2 text-ink-700">{message}</p>
    <a
      href={withBase("/")}
      class="btn-3d btn-3d-secondary mt-6 inline-flex items-center gap-2 rounded-xl px-5 py-2.5 font-medium text-blue-900"
    >
      <Icon name="arrow-right" size={16} class="rotate-180" /> Retour à l'accueil
    </a>
  </div>
</div>
