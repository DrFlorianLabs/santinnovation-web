---
import Icon from "./Icon.astro";
import { doctolib } from "@data/doctolib";

/** Barre d'actions sticky mobile : RDV, Appeler, Itinéraire. */
const actions = [
  {
    href: doctolib.etablissement,
    label: "Rendez-vous",
    icon: "calendar" as const,
    external: true,
    primary: true,
  },
  { href: "/lieux", label: "Itinéraire", icon: "navigation" as const, external: false, primary: false },
  { href: "/contact", label: "Contact", icon: "phone" as const, external: false, primary: false },
];
---

<nav
  aria-label="Actions rapides"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-blue-100 bg-white/95 backdrop-blur sm:hidden"
>
  {
    actions.map((a) => (
      <a
        href={withBase(a.href)}
        target={a.external ? "_blank" : undefined}
        rel={a.external ? "noopener noreferrer" : undefined}
        class:list={[
          "flex flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-medium",
          a.primary ? "text-teal-600" : "text-ink-700",
        ]}
      >
        <Icon name={a.icon} size={20} />
        {a.label}
      </a>
    ))
  }
</nav>
