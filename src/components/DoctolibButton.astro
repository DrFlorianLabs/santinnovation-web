---
import Icon from "./Icon.astro";
import { doctolib } from "@data/doctolib";

interface Props {
  /** URL spécifique (pro). Par défaut, la fiche établissement. */
  href?: string;
  label?: string;
  ariaLabel?: string;
  variant?: "primary" | "secondary";
  size?: "md" | "lg";
  class?: string;
}

const {
  href = doctolib.etablissement,
  label = "Prendre rendez-vous",
  ariaLabel,
  variant = "primary",
  size = "md",
  class: className = "",
} = Astro.props;

// Pas de whitespace-nowrap par défaut : les libellés longs (« Fiche
// établissement sur Doctolib ») doivent pouvoir passer à la ligne à 320 px.
// Les usages à libellé court le rajoutent via `class`.
const base =
  "btn-3d inline-flex max-w-full items-center justify-center gap-2 rounded-xl text-center font-medium focus-visible:outline-2 focus-visible:outline-offset-2";
const sizes = {
  md: "px-5 py-2.5 text-base",
  lg: "px-7 py-3.5 text-lg",
};
const variants = {
  primary: "btn-3d-primary text-white",
  secondary: "btn-3d-secondary text-blue-900 hover:text-teal-600",
};
---

<a
  href={href}
  aria-label={ariaLabel ? `${ariaLabel} — nouvelle fenêtre` : `${label} — Doctolib, nouvelle fenêtre`}
  target="_blank"
  rel="noopener noreferrer"
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  <Icon name="calendar" size={size === "lg" ? 22 : 18} />
  <span>{label}</span>
</a>
