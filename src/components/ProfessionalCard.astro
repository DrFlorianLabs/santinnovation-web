---
import Icon from "./Icon.astro";
import { withBase } from "@lib/paths";
import DoctolibButton from "./DoctolibButton.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  pro: CollectionEntry<"professionnels">;
  lieuxLabels?: Record<string, string>;
  heading?: "h2" | "h3";
  variant?: "card" | "plain";
}
const { pro, lieuxLabels = {}, heading: Heading = "h3", variant = "card" } = Astro.props;
const d = pro.data;
const aConfirmer = d.profession === "a-confirmer";
const initiales = `${d.prenom[0] ?? ""}${d.nom[0] ?? ""}`.toUpperCase();
const lieuxDuPro = d.lieux.map(id => lieuxLabels[id]).filter(Boolean);
---

<div class:list={["h-full", variant === "card" && "tilt-scene"]}>
  <article class:list={["relative flex h-full flex-col", variant === "plain" ? "home-professional py-6" : "tilt surface p-5"]}>
    {variant === "card" && <span class="tilt-glare" aria-hidden="true"></span>}

    <div class="tilt-pop-sm flex items-center gap-4">
      {
        d.photo ? (
          <figure class="shrink-0"><img
            src={withBase(d.photo)}
            alt={d.photoAlt || `Portrait de ${d.titreAffiche}`}
            width="64"
            height="64"
            class="h-16 w-16 rounded-full object-cover shadow-[0_6px_16px_-4px_rgba(18,50,74,0.35)] ring-2 ring-white"
            loading="lazy"
          />{d.photoCredit && <figcaption class="mt-2 max-w-32 text-xs text-ink-500">Crédit : {d.photoCredit}</figcaption>}</figure>
        ) : (
          <span
            class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-b from-sage-100 to-sage-500/30 font-display text-lg font-semibold text-sage-700 shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_6px_16px_-4px_rgba(30,77,58,0.25)] ring-2 ring-white"
            aria-hidden="true"
          >
            {initiales}
          </span>
        )
      }
      <div class="min-w-0">
        <Heading class="font-display text-lg font-semibold text-blue-900"><a href={withBase(`/equipe/${pro.id}`)} class="hover:underline">{d.titreAffiche}</a></Heading>
        <p
          class:list={[
            "text-sm font-medium",
            aConfirmer ? "text-ink-500" : "text-teal-600",
          ]}
        >
          {d.professionLabel}
        </p>
      </div>
    </div>

    {
      lieuxDuPro.length > 0 && (
        <p class="mt-4 flex items-center gap-1.5 text-sm text-ink-700">
          <span class="text-sage-500">
            <Icon name="map-pin" size={16} />
          </span>
          {lieuxDuPro.join(" · ")}
        </p>
      )
    }

    {
      d.domaines.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {d.domaines.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-700 shadow-[inset_0_1px_0_rgba(255,255,255,0.7)]">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <div class="tilt-pop-sm mt-auto flex items-center gap-3 pt-6">
      {
        aConfirmer ? (
          <span class="text-sm text-ink-500">Fiche en préparation</span>
        ) : (
          <>
            <DoctolibButton href={d.doctolibUrl} size="md" class="flex-1" />
            <a
              href={withBase(`/equipe/${pro.id}`)}
              class="text-sm font-medium text-blue-900 hover:text-teal-600"
            >
              Voir la fiche
            </a>
          </>
        )
      }
    </div>
  </article>
</div>
