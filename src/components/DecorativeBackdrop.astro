---
/** Mount once, outside section wrappers. The motif occupies the page gutter,
 * never the reading column. Its open roof, circuit and signal echo the logo;
 * this is decorative linework, not a replacement or alteration of the logo.
 */
const positions = [15, 46, 78];
---

<div class="scroll-motif" data-scroll-motif aria-hidden="true">
  {['base', 'progress'].map(layer => (
    <div class={`scroll-motif-layer scroll-motif-${layer}`}>
      <svg class="scroll-motif-spine" viewBox="0 0 96 640" preserveAspectRatio="none" fill="none" focusable="false">
        <path d="M48 0V62M48 130V176L22 202V238L48 264M48 326V370L74 396V438L48 464M48 534V575L30 593V640"></path>
        <path d="M22 220H6M74 414H90"></path>
        <circle class="scroll-motif-junction" cx="6" cy="220" r="2"></circle>
        <circle class="scroll-motif-junction" cx="90" cy="414" r="2"></circle>
      </svg>
      {positions.map(position => (
        <svg class="scroll-motif-mark" style={`top:${position}%`} viewBox="0 0 48 48" fill="none" focusable="false">
          <path class="scroll-motif-roof" d="M7 24 25 8 43 24M11 27v13h14"></path>
          <path class="scroll-motif-circuit" d="M26 40V28h9v12h5V26"></path>
          <path class="scroll-motif-signal" d="M7 17a12 12 0 0 1 9-10M3 23A20 20 0 0 1 18 3"></path>
          <circle class="scroll-motif-dot" cx="21" cy="3" r="1.2"></circle>
        </svg>
      ))}
    </div>
  ))}
</div>
