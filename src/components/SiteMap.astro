---
import Icon from './Icon.astro';
import { withBase } from '@lib/paths';
import type { CollectionEntry } from 'astro:content';
interface Props { lieux: CollectionEntry<'lieux'>[]; id?: string; compact?: boolean; }
const { lieux, id = 'carte', compact = false } = Astro.props;
const sites = lieux.map(l => ({
  id: l.id, nom: l.data.nom,
  adresse: `${l.data.adresse}, ${l.data.codePostal} ${l.data.ville}`,
  latitude: l.data.latitude, longitude: l.data.longitude,
  verified: l.data.adresseVerifiee,
}));
const geolocated = sites.filter(s => s.verified && Number.isFinite(s.latitude) && Number.isFinite(s.longitude));
const modes = [{ value: 'transit', label: 'Transports' }, { value: 'walking', label: 'À pied' }, { value: 'bicycling', label: 'Vélo' }, { value: 'driving', label: 'Voiture' }];
---
<div {id} class:list={["site-map grid grid-cols-1 gap-6", !compact && "lg:grid-cols-2"]} data-site-map data-sites={JSON.stringify(geolocated)}>
  <div class="map-panel relative overflow-hidden">
    <div class="map-intro flex h-full min-h-80 flex-col justify-center p-6 sm:p-10" data-map-intro>
      <span class="mb-4 text-teal-600"><Icon name="map-pin" size={32} /></span>
      <p class="font-display text-xl font-semibold text-blue-900">Situer les lieux de consultation</p>
      <p class="mt-3 text-sm text-ink-700">Retrouvez nos lieux de consultation à Besançon. Choisissez votre lieu puis préparez votre trajet.</p>
      {geolocated.length > 0 && <>
        <button type="button" class="btn-3d btn-3d-primary mt-5 self-start rounded-xl px-5 py-3 font-medium text-white" data-map-load hidden>Afficher la carte interactive</button>
        <p class="mt-3 text-xs text-ink-500">Ce clic charge un fond de carte IGN. Votre adresse IP est alors transmise à l’IGN.</p>
      </>}
      {geolocated.length === 0 && <p class="mt-3 text-sm text-ink-700">La carte sera disponible après vérification des coordonnées des lieux.</p>}
      <noscript><p class="mt-3 text-sm">Les liens d'itinéraire fonctionnent sans JavaScript.</p></noscript>

    </div>
    <div class="h-[28rem] w-full sm:h-[32rem]" data-map-canvas hidden role="region" aria-label="Carte interactive des lieux de consultation"></div>
    <p class="px-6 py-3 text-sm text-ink-700" role="status" data-map-status hidden></p>
  </div>
  {!compact && <ul class="space-y-4">
    {sites.map(s => <li class="surface p-5">
      <p class="font-display font-semibold text-blue-900"><a href={withBase(`/lieux/${s.id}`)} class="hover:underline">{s.nom}</a></p>
      <p class="mt-1 text-sm text-ink-700">{s.adresse}</p>
      {!s.verified && <p class="mt-2 text-sm font-medium text-ink-700">Adresse à confirmer avant votre déplacement.</p>}
      <div class="mt-4 grid grid-cols-2 gap-2">{modes.map(mode => <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.adresse)}&travelmode=${mode.value}`} target="_blank" rel="noopener noreferrer" aria-label={`Itinéraire ${mode.label.toLowerCase()} vers ${s.nom} — Google Maps`} class="btn-3d btn-3d-secondary rounded-lg px-3 py-2 text-center text-sm font-medium text-blue-900">{mode.label}</a>)}</div>
      <p class="mt-2 text-xs text-ink-500">Ouvre Google Maps ; vous pourrez choisir votre point de départ.</p>
    </li>)}
  </ul>}
</div>
<script>
  import 'leaflet/dist/leaflet.css';
  interface SiteData { id:string; nom:string; adresse:string; latitude:number; longitude:number; }
  document.querySelectorAll<HTMLElement>('[data-site-map]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-map-load]');
    const canvas = root.querySelector<HTMLElement>('[data-map-canvas]');
    const intro = root.querySelector<HTMLElement>('[data-map-intro]');
    const status = root.querySelector<HTMLElement>('[data-map-status]');
    if (!button || !canvas || !intro || !status) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.hidden = false;
      status.textContent = 'Chargement de la carte…';
      try {
        const { default: L } = await import('leaflet');
        const sites: SiteData[] = JSON.parse(root.dataset.sites ?? '[]');
        canvas.hidden = false;
        const map = L.map(canvas, { scrollWheelZoom: false });
        const tiles = L.tileLayer('https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&FORMAT=image/png&TILEMATRIXSET=PM_0_19&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}', {
          attribution: '&copy; <a href="https://cartes.gouv.fr/rechercher-une-donnee/dataset/IGNF_PLAN-IGN">IGN — Plan IGN · Licence Ouverte</a>', minZoom:0, maxZoom:19,
        }).addTo(map);
        tiles.on('tileerror', () => { status.hidden = false; status.textContent = 'Le fond de carte est indisponible. Utilisez les adresses et les itinéraires Google Maps.'; });
        tiles.on('tileload', () => { if (status.textContent === 'Chargement de la carte…') status.hidden = true; });
        for (const [index, s] of sites.entries()) {
          const dot = document.createElement('span');
          dot.className = 'map-pin'; dot.textContent = String(index + 1);
          const popup = document.createElement('div');
          const name = document.createElement('strong'); name.textContent = s.nom;
          const address = document.createElement('p'); address.textContent = s.adresse;
          const direction = document.createElement('a');
          direction.href = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(s.adresse)}`;
          direction.textContent = 'Itinéraire Google Maps'; direction.target = '_blank'; direction.rel = 'noopener noreferrer';
          popup.append(name, address, direction);
          L.marker([s.latitude,s.longitude], { title:s.nom, alt:s.nom, icon:L.divIcon({className:'',html:dot,iconSize:[32,32],iconAnchor:[16,16]}) }).addTo(map).bindPopup(popup);
        }
        map.fitBounds(L.latLngBounds(sites.map(s => [s.latitude,s.longitude] as [number,number])), {padding:[40,40],maxZoom:15});
        intro.hidden = true;
        canvas.tabIndex = -1;
        canvas.focus({preventScroll:true});
      } catch {
        canvas.hidden = true;
        intro.hidden = false;
        status.hidden = false;
        status.textContent = 'La carte ne peut pas être chargée. Les adresses et les liens d’itinéraire restent disponibles.';
        button.disabled = false;
      }
    });
  });
</script>
<style is:global>
.map-panel { border-radius:1rem; background:#edf7f5; border:1px solid #02325012; }
.map-intro { background:radial-gradient(ellipse at 100% 0%, #80c16720, transparent 65%), linear-gradient(135deg,#f5fafa,#e3f3f1); }
.map-pin { display:grid; place-items:center; width:32px; height:32px; border:3px solid white; border-radius:50%; background:#023250; color:white; font-size:13px; font-weight:700; box-shadow:0 2px 8px #02325040; }
.leaflet-container { font-family:var(--font-sans); }
.leaflet-control-attribution { font-size:.7rem; }
</style>
