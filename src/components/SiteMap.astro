---
import Icon from './Icon.astro';
import { withBase } from '@lib/paths';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lieux: CollectionEntry<'lieux'>[];
  id?: string;
  compact?: boolean;
  heading?: 'h2' | 'h3';
}
const { lieux, id = 'carte', compact = false, heading: Heading = 'h3' } = Astro.props;
const sites = lieux.map((lieu, index) => ({
  id: lieu.id, numero: index + 1, nom: lieu.data.nom,
  adresse: `${lieu.data.adresse}, ${lieu.data.codePostal} ${lieu.data.ville}`,
  latitude: lieu.data.latitude, longitude: lieu.data.longitude,
  verified: lieu.data.adresseVerifiee,
}));
const geolocated = sites.filter(site => site.verified
  && Number.isFinite(site.latitude) && Number.isFinite(site.longitude)
  && Math.abs(site.latitude!) <= 90 && Math.abs(site.longitude!) <= 180);
const itinerary = (address: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<div {id} class:list={['site-map', { 'site-map-compact': compact }]} data-site-map data-sites={JSON.stringify(geolocated)}>
  <div class="map-column">
    <div class="map-panel" data-map-panel>
      <div class="map-intro flex flex-col justify-center p-6" data-map-intro>
        <span class="mb-3 text-teal-600"><Icon name="map-pin" size={28} /></span>
        <p class="font-display text-lg font-semibold text-blue-900">Situer les lieux de consultation</p>
        {geolocated.length > 0
          ? <p class="mt-3 text-sm text-ink-700">Retrouvez les adresses sur la carte et préparez votre trajet.</p>
          : <p class="mt-3 text-sm text-ink-700">La carte sera disponible après vérification des coordonnées des lieux.</p>}
        <noscript><p class="mt-3 text-sm text-ink-700">La carte interactive nécessite JavaScript. Les adresses et les liens d’itinéraire ci-dessous restent utilisables.</p></noscript>
      </div>
      <div class="map-canvas w-full" data-map-canvas hidden role="region" aria-label="Carte interactive des lieux de consultation"></div>
      <div class="map-feedback px-5" data-map-feedback hidden>
        <p class="text-sm text-ink-700" role="status" aria-live="polite" aria-atomic="true" data-map-status></p>
        {geolocated.length > 0 && <button type="button" class="mt-3 rounded-lg border border-blue-900/25 px-3 py-2 text-sm font-semibold text-blue-900 underline underline-offset-4" data-map-retry hidden>Réessayer le chargement de la carte</button>}
      </div>
      {geolocated.length > 0 && <p class="map-privacy border-t border-blue-900/10 px-5 py-3 text-xs leading-relaxed text-ink-700">Fond de carte IGN : votre adresse IP est transmise à l’IGN lors du chargement. <a href={withBase('/confidentialite')} class="underline underline-offset-2">Confidentialité</a></p>}
    </div>
  </div>

  <ul class="map-locations min-w-0">
    {lieux.map((lieu, index) => <li id={`lieu-${lieu.id}`} tabindex="-1" class="map-location py-6 first:pt-0">
      <article aria-labelledby={`${id}-lieu-title-${lieu.id}`}>
        <div class="flex items-start gap-3">
          <span class="map-site-number shrink-0" aria-hidden="true">{index + 1}</span>
          <Heading id={`${id}-lieu-title-${lieu.id}`} class="font-display text-xl font-semibold text-blue-900">{lieu.data.nom}</Heading>
        </div>
        <address class="mt-3 text-sm not-italic text-ink-700">{lieu.data.adresse}<br />{lieu.data.codePostal} {lieu.data.ville}</address>
        {!lieu.data.adresseVerifiee && <p class="mt-2 text-sm font-medium text-ink-700">Adresse à confirmer auprès du professionnel avant votre déplacement.</p>}
        <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
          <div><dt class="font-semibold text-blue-900">Horaires d’ouverture</dt><dd class="mt-1 whitespace-pre-line text-ink-700">{lieu.data.horaires || 'Horaires non renseignés. Consultez les modalités de chaque professionnel.'}</dd></div>
          <div><dt class="font-semibold text-blue-900">Accessibilité</dt><dd class="mt-1 whitespace-pre-line text-ink-700">{lieu.data.accessibilite || (lieu.data.accesPMR === true ? 'Accès aux personnes à mobilité réduite indiqué par le lieu.' : 'Conditions d’accès non renseignées. Contactez le professionnel avant votre déplacement.')}</dd></div>
          {lieu.data.accesTransport && <div><dt class="font-semibold text-blue-900">Transports</dt><dd class="mt-1 whitespace-pre-line text-ink-700">{lieu.data.accesTransport}</dd></div>}
          {lieu.data.infosPratiques && <div class="sm:col-span-2"><dt class="font-semibold text-blue-900">Informations pratiques</dt><dd class="mt-1 whitespace-pre-line text-ink-700">{lieu.data.infosPratiques}</dd></div>}
        </dl>
        {lieu.data.telephone && <p class="mt-4 text-sm"><a href={`tel:${lieu.data.telephone.replace(/[^+0-9]/g, '')}`} class="font-medium text-blue-900 underline underline-offset-4">{lieu.data.telephone}</a></p>}
        <div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
          <a href={itinerary(`${lieu.data.adresse}, ${lieu.data.codePostal} ${lieu.data.ville}`)} target="_blank" rel="noopener noreferrer" class="btn-3d btn-3d-secondary inline-flex items-center gap-2 rounded-xl px-4 py-2.5 font-medium text-blue-900" aria-label={`Itinéraire vers ${lieu.data.nom} — nouvel onglet`}><Icon name="navigation" size={16} />Itinéraire</a>
          <a href={withBase(`/lieux/${lieu.id}`)} class="font-medium text-teal-600 underline underline-offset-4">Détails et professionnels du lieu</a>
        </div>
      </article>
    </li>)}
  </ul>
</div>

<script>
  import 'leaflet/dist/leaflet.css';
  import type { Map as LeafletMap } from 'leaflet';

  interface SiteData { id: string; numero: number; nom: string; adresse: string; latitude: number; longitude: number; }
  document.querySelectorAll<HTMLElement>('[data-site-map]').forEach(root => {
    if (root.dataset.mapInitialized) return;
    root.dataset.mapInitialized = 'true';
    const panel = root.querySelector<HTMLElement>('[data-map-panel]');
    const canvas = root.querySelector<HTMLElement>('[data-map-canvas]');
    const intro = root.querySelector<HTMLElement>('[data-map-intro]');
    const feedback = root.querySelector<HTMLElement>('[data-map-feedback]');
    const status = root.querySelector<HTMLElement>('[data-map-status]');
    const retry = root.querySelector<HTMLButtonElement>('[data-map-retry]');
    if (!panel || !canvas || !intro || !feedback || !status || !retry) return;
    let map: LeafletMap | undefined;
    let loading = false;
    let attempt = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const load = async () => {
      if (loading) return;
      loading = true;
      const currentAttempt = ++attempt;
      clearTimeout(timer);
      map?.remove();
      map = undefined;
      retry.disabled = true;
      feedback.hidden = false;
      status.textContent = 'Chargement de la carte…';
      canvas.setAttribute('aria-busy', 'true');

      const failure = (message: string) => {
        if (currentAttempt !== attempt) return;
        clearTimeout(timer);
        loading = false;
        canvas.setAttribute('aria-busy', 'false');
        feedback.hidden = false;
        status.textContent = message;
        retry.hidden = false;
        retry.disabled = false;
        retry.textContent = 'Réessayer le chargement de la carte';
      };
      timer = setTimeout(() => failure('La carte met trop de temps à répondre. Les adresses et les itinéraires restent utilisables.'), 15_000);

      try {
        const sites: SiteData[] = JSON.parse(root.dataset.sites ?? '[]');
        if (!sites.length) throw new Error('Aucun lieu géolocalisé.');
        const { default: L } = await import('leaflet');
        if (currentAttempt !== attempt) return;
        canvas.hidden = false;
        intro.hidden = true;
        const animate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        map = L.map(canvas, { scrollWheelZoom: false, zoomAnimation: animate, fadeAnimation: animate, markerZoomAnimation: animate });
        let tileErrors = false;
        const tiles = L.tileLayer('https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&FORMAT=image/png&TILEMATRIXSET=PM_0_19&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}', {
          attribution: '&copy; <a href="https://cartes.gouv.fr/rechercher-une-donnee/dataset/IGNF_PLAN-IGN">IGN — Plan IGN · Licence Ouverte</a>', minZoom: 0, maxZoom: 19,
        });
        tiles.on('loading', () => { tileErrors = false; });
        tiles.on('tileerror', () => {
          tileErrors = true;
          failure('Le fond de carte est indisponible ou incomplet. Les adresses et les itinéraires restent utilisables.');
        });
        tiles.on('load', () => {
          if (currentAttempt !== attempt || tileErrors) return;
          clearTimeout(timer);
          loading = false;
          canvas.setAttribute('aria-busy', 'false');
          status.textContent = '';
          // Keep a previously used retry control in place, preserving keyboard focus.
          feedback.hidden = retry.hidden;
          retry.disabled = false;
          retry.textContent = 'Recharger la carte';
        });
        tiles.addTo(map);
        for (const site of sites) {
          const dot = document.createElement('span');
          dot.className = 'map-pin'; dot.textContent = String(site.numero);
          const popup = document.createElement('div');
          const name = document.createElement('strong'); name.textContent = site.nom;
          const address = document.createElement('p'); address.textContent = site.adresse;
          const direction = document.createElement('a');
          direction.href = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.adresse)}`;
          direction.textContent = 'Itinéraire'; direction.target = '_blank'; direction.rel = 'noopener noreferrer';
          direction.setAttribute('aria-label', `Itinéraire vers ${site.nom} — nouvel onglet`);
          popup.append(name, address, direction);
          L.marker([site.latitude, site.longitude], {
            title: `${site.numero}. ${site.nom}`, alt: site.nom,
            icon: L.divIcon({ className: '', html: dot, iconSize: [32, 32], iconAnchor: [16, 16] }),
          }).addTo(map).bindPopup(popup);
        }
        map.fitBounds(L.latLngBounds(sites.map(site => [site.latitude, site.longitude] as [number, number])), { padding: [30, 30], maxZoom: 15, animate: false });
      } catch {
        if (currentAttempt !== attempt) return;
        map?.remove();
        map = undefined;
        canvas.hidden = true;
        intro.hidden = false;
        failure('La carte ne peut pas être chargée. Les adresses et les liens d’itinéraire restent disponibles.');
      }
    };

    retry.addEventListener('click', () => { void load(); });
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer.disconnect();
          void load();
        }
      }, { rootMargin: '300px 0px', threshold: 0 });
      observer.observe(panel);
    } else {
      void load();
    }
  });
</script>

<style is:global>
  .site-map { display:grid; grid-template-columns:minmax(0,1fr); align-items:start; gap:2rem; }
  .site-map .map-column { min-width:0; }
  .site-map .map-panel { overflow:hidden; border-radius:1rem; background:#edf7f5; border:1px solid #02325012; }
  .site-map .map-intro, .site-map .map-canvas { height:clamp(18rem,40vh,24rem); }
  .site-map-compact .map-intro, .site-map-compact .map-canvas { height:20rem; }
  .site-map .map-intro { background:radial-gradient(ellipse at 100% 0%,#80c16720,transparent 65%),linear-gradient(135deg,#f5fafa,#e3f3f1); }
  .site-map .map-feedback { padding-block:1rem; }
  .site-map .map-location + .map-location { border-top:1px solid #02325029; }
  .site-map .map-site-number { display:grid; place-items:center; width:1.75rem; height:1.75rem; border-radius:50%; background:#023250; color:white; font-size:.8rem; font-weight:700; }
  .map-pin { display:grid; place-items:center; width:32px; height:32px; border:3px solid white; border-radius:50%; background:#023250; color:white; font-size:13px; font-weight:700; box-shadow:0 2px 8px #02325040; }
  .site-map .leaflet-container { font-family:var(--font-sans); }
  .site-map .leaflet-control-attribution { font-size:.7rem; }
  @media (min-width:1024px) {
    .site-map { grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(2rem,4vw,4rem); }
    .site-map .map-column { position:sticky; top:7rem; }
    .site-map .map-intro, .site-map .map-canvas { height:clamp(18rem,calc(100svh - 18rem),25rem); }
  }
</style>
