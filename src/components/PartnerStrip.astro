---
import { partenaires } from "@data/partenaires";

interface Props {
  title?: string;
  variant?: "light" | "dark";
}
const { title = "Notre écosystème", variant = "light" } = Astro.props;
const isDark = variant === "dark";
---

<section class:list={["py-14", isDark ? "text-white/80" : "text-ink-700"]}>
  <div class="container-site">
    <p
      class:list={[
        "mb-7 text-center text-sm font-medium uppercase tracking-wide",
        isDark ? "text-white/60" : "text-ink-500",
      ]}
    >
      {title}
    </p>
    <ul class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {
        partenaires.map((p) => (
          <li>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              title={p.description}
              class:list={[
                "inline-flex items-center gap-1.5 rounded-xl px-4 py-2.5 font-display text-sm font-medium transition-all duration-200 hover:-translate-y-0.5 sm:text-base",
                isDark
                  ? "bg-white/5 text-white/80 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-white/10 hover:text-white hover:ring-teal-500/50"
                  : "bg-white text-blue-900/80 shadow-[inset_0_1px_0_rgba(255,255,255,1),0_4px_12px_-4px_rgba(18,50,74,0.18)] ring-1 ring-blue-100 hover:text-teal-600 hover:shadow-[var(--shadow-e2)] hover:ring-teal-600/40",
              ]}
            >
              {p.nom}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
