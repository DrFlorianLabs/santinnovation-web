---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { site } from "@data/site";
import { mainNav, footerNav, legalNav } from "@data/navigation";
import { getCollection } from "astro:content";

const lieux = (await getCollection("lieux")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden bg-blue-950 text-white/80">
  <!-- Halo de profondeur en haut du footer -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-500/60 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-teal-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-site relative grid grid-cols-1 gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2.5 text-white" style="--logo-house: #ffffff">
        <Logo size={44} static />
        <span class="font-display text-lg font-semibold">
          Sant'<span class="text-brand-gradient">Innovation</span>
        </span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-white/70">{site.baseline}</p>
      <p class="mt-4 text-sm text-white/60">{site.nom}</p>
      <a
        href="/pro"
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-white/5 px-4 py-2.5 text-sm font-medium text-white/80 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-white/10 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/10 hover:text-white"
      >
        <Icon name="lock" size={15} /> Espace professionnel
      </a>
    </div>

    <nav aria-label="Plan du site">
      <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white/90">
        Naviguer
      </h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          [...footerNav, ...mainNav].map((item) => (
            <li>
              <a href={item.href} class="text-white/70 transition-colors hover:text-teal-500">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white/90">
        Nos lieux
      </h2>
      <ul class="mt-4 space-y-3 text-sm text-white/70">
        {
          lieux.map((l) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 shrink-0 text-teal-500">
                <Icon name="map-pin" size={16} />
              </span>
              <span>
                {l.data.nom}
                <br />
                <span class="text-white/55">
                  {l.data.adresse}, {l.data.codePostal} {l.data.ville}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white/90">
        Contact
      </h2>
      <ul class="mt-4 space-y-2 text-sm text-white/70">
        <li>
          <a href={`mailto:${site.contact.general}`} class="hover:text-teal-500">
            {site.contact.general}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.contact.secretariat}`} class="hover:text-teal-500">
            {site.contact.secretariat}
          </a>
        </li>
      </ul>
      <div
        class="mt-5 flex items-start gap-2 rounded-xl bg-white/5 p-3 text-xs text-white/60 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] ring-1 ring-white/10"
      >
        <span class="mt-0.5 shrink-0 text-warning"><Icon name="alert-triangle" size={15} /></span>
        <span>Urgence : appelez le 15 ou le 112. Ce site ne traite pas les urgences médicales.</span>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div
      class="container-site flex flex-col items-center justify-between gap-3 py-5 text-xs text-white/50 sm:flex-row"
    >
      <p>© {year} {site.nomCourt}. Tous droits réservés.</p>
      <ul class="flex flex-wrap items-center gap-4">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-teal-500">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
