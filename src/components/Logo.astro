---
import { withBase } from '@lib/paths';
/** Vector symbol from the user-provided identity kit of 10 October 2026. */
interface Props {
  size?: number;
  class?: string;
  title?: string;
  static?: boolean;
  tone?: 'brand' | 'light';
}
const { size = 40, class: className, title = "Sant’Innovation", tone = 'brand' } = Astro.props;
---
<img
  src={withBase(tone === 'light' ? '/brand/symbole-blanc.svg' : '/brand/symbole.svg')}
  width={size}
  height={Math.round(size * .82777358)}
  class:list={['shrink-0 object-contain', className]}
  alt={title}
  decoding="async"
/>
