---
/**
 * Logo Sant'Innovation — reproduction fidèle du logo original :
 * toit débordant, fenêtre 4 carreaux, mur-sol en « L » (marine),
 * ligne-circuit continue porte → sol → mur droit (dégradé cyan → vert),
 * double signal en arc avec trois points.
 *
 * Animation : le logo est toujours entièrement visible (identité lisible
 * d'emblée). Seul le signal vit : les deux arcs et les points pulsent
 * doucement en cascade, comme une émission — la maison connectée,
 * les soins coordonnés. Sobre, continu, sans surprise.
 *
 * Couleur de la maison pilotée par --logo-house (marine par défaut,
 * blanc sur fond sombre).
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
  /** Désactive l'animation (listes, répétitions). */
  static?: boolean;
}
const {
  size = 40,
  class: className,
  title = "Sant'Innovation",
  static: isStatic = false,
} = Astro.props;
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="-2 -7 106 95"
  width={size}
  height={size}
  class:list={[!isStatic && "logo-live", className]}
  role="img"
  aria-label={title}
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1BA3C2"></stop>
      <stop offset="100%" stop-color="#62BB46"></stop>
    </linearGradient>
    <linearGradient id={`${uid}b`} x1="0" y1="1" x2="0.7" y2="0">
      <stop offset="0%" stop-color="#1BA3C2"></stop>
      <stop offset="100%" stop-color="#62BB46"></stop>
    </linearGradient>
  </defs>

  <!-- Toit débordant -->
  <path
    d="M7.5 42 L53 3.5 L98.5 41"
    stroke="var(--logo-house, #12324A)"
    stroke-width="7.5"
  ></path>

  <!-- Mur gauche + sol (L) -->
  <path
    d="M16 44 V76.5 Q16 80.5 20 80.5 H52"
    stroke="var(--logo-house, #12324A)"
    stroke-width="6.4"
  ></path>

  <!-- Fenêtre 4 carreaux -->
  <g fill="var(--logo-house, #12324A)">
    <rect x="29.2" y="39.6" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="36.6" y="39.6" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="29.2" y="46.9" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="36.6" y="46.9" width="4.9" height="4.9" rx="0.8"></rect>
  </g>

  <!-- Ligne-circuit : porte → sol → mur droit (une seule ligne) -->
  <path
    d="M58 80.5 V51.5 Q58 47.5 62 47.5 H74 Q78 47.5 78 51.5 V76.5 Q78 80.5 82 80.5 H84.8 Q88.8 80.5 88.8 76.5 V43"
    stroke={`url(#${uid})`}
    stroke-width="6.4"
  ></path>

  <!-- Signal : deux arcs concentriques qui pulsent en cascade -->
  <path
    class="logo-wave logo-wave-1"
    d="M10 33 A 22 22 0 0 1 22.5 12"
    stroke="#62BB46"
    stroke-width="2.8"
  ></path>
  <path
    class="logo-wave logo-wave-2"
    d="M2 50 A 38 38 0 0 1 31 -1"
    stroke={`url(#${uid}b)`}
    stroke-width="3.2"
  ></path>

  <!-- Points : dans le prolongement de chaque arc -->
  <circle class="logo-dot logo-dot-1" cx="26.5" cy="9.5" r="2.6" fill="#62BB46"></circle>
  <circle class="logo-dot logo-dot-2" cx="35" cy="-3" r="3.3" fill="#62BB46"></circle>
  <circle class="logo-dot logo-dot-3" cx="1.5" cy="55.5" r="2.9" fill="#1BA3C2"></circle>
</svg>

<style>
  /*
    Le logo reste entier en permanence. Seul le « signal » respire :
    petit arc → grand arc → points, en cascade douce (cycle 4,5 s),
    comme une émission régulière. Amplitude faible, jamais invisible.
  */
  .logo-live .logo-wave {
    opacity: 0.55;
    transform-origin: center;
    transform-box: fill-box;
    animation: logo-wave 4.5s ease-in-out infinite;
  }
  .logo-live .logo-wave-2 {
    animation-delay: 0.35s;
  }
  .logo-live .logo-dot {
    transform-origin: center;
    transform-box: fill-box;
    animation: logo-dot 4.5s ease-in-out infinite;
  }
  .logo-live .logo-dot-1 {
    animation-delay: 0.5s;
  }
  .logo-live .logo-dot-2 {
    animation-delay: 0.7s;
  }
  .logo-live .logo-dot-3 {
    animation-delay: 0.9s;
  }
  @keyframes logo-wave {
    0%,
    100% {
      opacity: 0.55;
    }
    30% {
      opacity: 1;
    }
    60% {
      opacity: 0.55;
    }
  }
  @keyframes logo-dot {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    30% {
      transform: scale(1.18);
      opacity: 1;
    }
    60% {
      transform: scale(1);
      opacity: 0.8;
    }
  }
  /* Respiration d'ensemble très lente (scale ±1 %) — perceptible par un
     visiteur attentif, invisible en usage courant. Desktop pointeur fin. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .logo-live {
      transform-origin: center;
      animation: logo-breathe 9s ease-in-out infinite;
    }
  }
  @keyframes logo-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.012);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-live .logo-wave,
    .logo-live .logo-dot {
      animation: none;
      opacity: 1;
    }
  }
</style>
