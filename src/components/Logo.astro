---
/**
 * Logo Sant'Innovation — reproduction fidèle du logo original :
 * toit débordant, fenêtre 4 carreaux, mur-sol en « L » (marine),
 * ligne-circuit continue porte → sol → mur droit (dégradé cyan → vert),
 * double signal en arc avec trois points.
 *
 * SVG vivant : cycle lent en boucle (tracé, pause, retrait).
 * Couleur de la maison pilotée par --logo-house (marine par défaut,
 * blanc sur fond sombre).
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
  /** Désactive l'animation (listes, répétitions). */
  static?: boolean;
}
const {
  size = 40,
  class: className,
  title = "Sant'Innovation",
  static: isStatic = false,
} = Astro.props;
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="-2 -7 106 95"
  width={size}
  height={size}
  class:list={[!isStatic && "logo-live", className]}
  role="img"
  aria-label={title}
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1BA3C2"></stop>
      <stop offset="100%" stop-color="#62BB46"></stop>
    </linearGradient>
    <linearGradient id={`${uid}b`} x1="0" y1="1" x2="0.7" y2="0">
      <stop offset="0%" stop-color="#1BA3C2"></stop>
      <stop offset="100%" stop-color="#62BB46"></stop>
    </linearGradient>
  </defs>

  <!-- Toit débordant -->
  <path
    class="logo-path"
    pathLength="100"
    d="M7.5 42 L53 3.5 L98.5 41"
    stroke="var(--logo-house, #12324A)"
    stroke-width="7.5"
  ></path>

  <!-- Mur gauche + sol (L) -->
  <path
    class="logo-path logo-path-late"
    pathLength="100"
    d="M16 44 V76.5 Q16 80.5 20 80.5 H52"
    stroke="var(--logo-house, #12324A)"
    stroke-width="6.4"
  ></path>

  <!-- Fenêtre 4 carreaux -->
  <g fill="var(--logo-house, #12324A)" class="logo-windows">
    <rect x="29.2" y="39.6" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="36.6" y="39.6" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="29.2" y="46.9" width="4.9" height="4.9" rx="0.8"></rect>
    <rect x="36.6" y="46.9" width="4.9" height="4.9" rx="0.8"></rect>
  </g>

  <!-- Ligne-circuit : porte → sol → mur droit (une seule ligne) -->
  <path
    class="logo-path logo-path-late"
    pathLength="100"
    d="M58 80.5 V51.5 Q58 47.5 62 47.5 H74 Q78 47.5 78 51.5 V76.5 Q78 80.5 82 80.5 H84.8 Q88.8 80.5 88.8 76.5 V43"
    stroke={`url(#${uid})`}
    stroke-width="6.4"
  ></path>

  <!-- Signal : deux arcs de cercle concentriques, bien dégagés du toit -->
  <path
    class="logo-path logo-path-late"
    pathLength="100"
    d="M2 50 A 38 38 0 0 1 31 -1"
    stroke={`url(#${uid}b)`}
    stroke-width="3.2"
  ></path>
  <path
    class="logo-path logo-path-later"
    pathLength="100"
    d="M10 33 A 22 22 0 0 1 22.5 12"
    stroke="#62BB46"
    stroke-width="2.8"
  ></path>

  <!-- Points : dans le prolongement de chaque arc -->
  <circle class="logo-dot" cx="35" cy="-3" r="3.3" fill="#62BB46"></circle>
  <circle class="logo-dot logo-dot-2" cx="1.5" cy="55.5" r="2.9" fill="#1BA3C2"></circle>
  <circle class="logo-dot logo-dot-3" cx="26.5" cy="9.5" r="2.6" fill="#62BB46"></circle>
</svg>

<style>
  /*
    Cycle lent en boucle (12 s) :
    le tracé se dessine (0→30 %), reste affiché (30→78 %),
    puis se retire dans le sens du tracé (78→100 %) et recommence.
    pathLength="100" : tous les tracés partagent le même rythme.
  */
  .logo-live .logo-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: logo-cycle 12s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }
  .logo-live .logo-path-late {
    animation-delay: 0.9s;
  }
  .logo-live .logo-path-later {
    animation-delay: 1.5s;
  }
  .logo-live .logo-windows {
    opacity: 0;
    animation: logo-windows-cycle 12s ease infinite;
  }
  .logo-live .logo-dot {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: logo-dot-cycle 12s ease-in-out infinite;
  }
  .logo-live .logo-dot-2 {
    animation-delay: 0.6s;
  }
  .logo-live .logo-dot-3 {
    animation-delay: 1.1s;
  }
  @keyframes logo-cycle {
    0% {
      stroke-dashoffset: 100;
    }
    30%,
    78% {
      stroke-dashoffset: 0;
    }
    98%,
    100% {
      stroke-dashoffset: -100;
    }
  }
  @keyframes logo-windows-cycle {
    0%,
    26% {
      opacity: 0;
    }
    36%,
    76% {
      opacity: 1;
    }
    88%,
    100% {
      opacity: 0;
    }
  }
  @keyframes logo-dot-cycle {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.4);
    }
    40% {
      opacity: 1;
      transform: scale(1);
    }
    55% {
      transform: scale(1.22);
    }
    70%,
    78% {
      opacity: 1;
      transform: scale(1);
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-live .logo-path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
    .logo-live .logo-windows,
    .logo-live .logo-dot {
      opacity: 1;
      animation: none;
    }
  }
</style>
