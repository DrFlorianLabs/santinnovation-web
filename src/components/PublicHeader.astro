---
import Icon from "./Icon.astro";
import { withBase } from "@lib/paths";
import Logo from "./Logo.astro";
import DoctolibButton from "./DoctolibButton.astro";
import { mainNav } from "@data/navigation";
import { site } from "@data/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  data-elevate-on-scroll
  class="glass sticky top-0 z-40 border-b border-white/50 transition-shadow duration-300 data-[elevated=true]:shadow-[var(--shadow-e3)]"
>
  <!--
    Alignement : une seule rangée h-16, tout est centré verticalement,
    tous les libellés sont en nowrap — rien ne passe sur deux lignes,
    rien ne déborde. Largeur élargie (1440px) pour laisser respirer.
  -->
  <div
    class="mx-auto flex h-16 w-full max-w-[90rem] items-center justify-between gap-3 px-4 md:px-6"
  >
    <a
      href={withBase("/")}
      class="flex shrink-0 items-center gap-2.5"
      aria-label={`${site.nomCourt} — accueil`}
    >
      <Logo size={42} />
      <span class="whitespace-nowrap font-display text-lg font-semibold leading-none text-blue-900">
        Sant'<span class="text-brand-gradient">Innovation</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden min-w-0 lg:block">
      <ul class="flex items-center justify-center">
        {
          mainNav.map((item) => (
            <li class="flex">
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "relative flex h-10 items-center whitespace-nowrap rounded-lg px-2.5 text-sm font-medium leading-none transition-colors duration-200 xl:px-3 xl:text-[0.92rem]",
                  isActive(item.href)
                    ? "text-teal-600"
                    : "text-ink-700 hover:bg-blue-100/60 hover:text-blue-900",
                ]}
              >
                {item.label}
                {isActive(item.href) && (
                  <span
                    class="absolute inset-x-2.5 bottom-1 h-0.5 rounded-full bg-gradient-to-r from-teal-600 to-green-500"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* /pro (démo) volontairement absent de la navigation publique (AUD-002). */}
    <div class="flex shrink-0 items-center gap-2.5">
      {/* Wrapper : `hidden` sur le bouton lui-même serait neutralisé par son
          `inline-flex` de base (même spécificité CSS) — cause du débordement
          horizontal mobile relevé par l'audit (AUD-013). */}
      <div class="hidden sm:block">
        <DoctolibButton class="h-10 whitespace-nowrap" label="Rendez-vous" />
      </div>
      <details class="relative lg:hidden">
        <summary
          class="btn-3d btn-3d-secondary flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl text-blue-900"
          aria-label="Ouvrir le menu"
        >
          <Icon name="menu" size={22} />
        </summary>
        <div class="surface surface-raised absolute right-0 mt-2 w-64 p-2">
          <ul>
            {
              mainNav.map((item) => (
                <li>
                  <a
                    href={withBase(item.href)}
                    class="block rounded-lg px-3 py-2.5 text-ink-950 hover:bg-blue-100"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={withBase("/prendre-rendez-vous")}
                class="block rounded-lg px-3 py-2.5 text-ink-950 hover:bg-blue-100"
              >
                Prendre rendez-vous
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
