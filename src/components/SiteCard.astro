---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '@lib/paths';
interface Props { lieu: CollectionEntry<'lieux'>; heading?: 'h2' | 'h3'; }
const { lieu, heading: Heading = 'h2' } = Astro.props;
const d = lieu.data;
const direction = d.itineraireUrl ?? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${d.adresse}, ${d.codePostal} ${d.ville}`)}`;
---
<article class="surface flex h-full flex-col overflow-hidden">
  {d.photo && <img src={withBase(d.photo)} width="640" height="360" alt={d.photoAlt || `Le lieu de consultation ${d.nom}`} class="aspect-video w-full object-cover" loading="lazy" />}
  {d.photo && d.photoCredit && <p class="px-6 pt-3 text-xs text-ink-500">Crédit : {d.photoCredit}</p>}
  <div class="flex flex-1 flex-col p-6">
    <Heading class="text-xl font-semibold"><a href={withBase(`/lieux/${lieu.id}`)} class="hover:underline">{d.nom}</a></Heading>
    {d.secteur && <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-sage-700">{d.secteur}</p>}
    <p class="mt-3 text-sm text-ink-700">{d.adresse}<br />{d.codePostal} {d.ville}</p>
    {d.horaires && <p class="mt-3 whitespace-pre-line text-sm text-ink-700">{d.horaires}</p>}
    <div class="mt-auto flex flex-wrap gap-4 pt-5 text-sm font-medium text-blue-900">
      <a href={withBase(`/lieux/${lieu.id}`)} class="underline underline-offset-4">Accès et professionnels</a>
      <a href={direction} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:underline" aria-label={`Itinéraire vers ${d.nom} — nouvelle fenêtre`}><Icon name="navigation" size={16} /> Itinéraire</a>
    </div>
  </div>
</article>
