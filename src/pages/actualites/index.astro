---
import { getCollection } from 'astro:content';
import { isPublishedArticle } from '@lib/publication';
import EditorialContent from "@components/EditorialContent.astro";
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import NewsCard from '@components/NewsCard.astro';
const actus = (await getCollection('actualites')).filter(isPublishedArticle).sort((a,b) => Number(b.data.epingle)-Number(a.data.epingle) || b.data.date.valueOf()-a.data.date.valueOf());
const page = (await getCollection("pages")).find(p => p.id === "actualites");
---
<BaseLayout title="Actualités" description="Les actualités et événements de Sant'Innovation à Besançon : prévention, vie de l'équipe, recherche et organisation des soins.">
  <PageHero eyebrow="Vie de la maison de santé" title="Actualités et événements" description="Prévention, vie de l'équipe, organisation des soins et innovation. Retrouvez ici les informations publiées par Sant'Innovation." />
  <section class="py-12 md:py-16"><div class="container-site">
      {page && <div class="mb-8 max-w-prose"><EditorialContent entry={page} /></div>}
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{actus.map(actu => <li><NewsCard actu={actu} /></li>)}</ul>
    {actus.length === 0 && <p class="surface p-6 text-ink-700">Aucune actualité publiée pour le moment.</p>}
  </div></section>
</BaseLayout>
