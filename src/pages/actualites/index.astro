---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import Icon from "@components/Icon.astro";
import { formatDate } from "@lib/format";

const actus = (await getCollection("actualites"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Actualités"
  description="Les actualités des Maisons de Santé Pluriprofessionnelles Sant'Innovation à Besançon : vie de l'équipe, prévention, organisation, innovation."
>
  <PageHero
    eyebrow="Vie de la maison de santé"
    title="Actualités"
    description="Vie de l'équipe, prévention, organisation des soins et innovation."
  />

  <section class="py-12 md:py-16">
    <div class="container-site">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          actus.map((a) => (
            <li class="tilt-scene h-full">
              <article class="tilt surface relative flex h-full flex-col p-6">
                <span class="tilt-glare" aria-hidden="true" />
                <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-teal-600">
                  <Icon name="sparkles" size={14} /> {a.data.categorie}
                </p>
                <h2 class="mt-2 font-display text-lg font-semibold text-blue-900">
                  <a href={`/actualites/${a.id}`} class="hover:text-teal-600">
                    {a.data.titre}
                  </a>
                </h2>
                <p class="mt-2 text-sm text-ink-700">{a.data.resume}</p>
                <p class="mt-auto pt-4 text-xs text-ink-500">{formatDate(a.data.date)}</p>
              </article>
            </li>
          ))
        }
      </ul>
      {actus.length === 0 && <p class="text-ink-700">Aucune actualité publiée pour le moment.</p>}
    </div>
  </section>
</BaseLayout>
