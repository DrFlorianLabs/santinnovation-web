---
import { getCollection } from 'astro:content';
import { isPublishedArticle } from '@lib/publication';
import { withBase } from '@lib/paths';
import { formatDate, formatDateTime } from '@lib/format';
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialContent from '@components/EditorialContent.astro';
export async function getStaticPaths() { return (await getCollection('actualites')).filter(isPublishedArticle).map(actu => ({params:{slug:actu.id},props:{actu}})); }
const { actu } = Astro.props;
const d = actu.data;
---
<BaseLayout title={d.titre} description={d.resume}>
  <section class="relative overflow-hidden border-b border-blue-100"><div class="aurora opacity-60" aria-hidden="true"></div><div class="container-site relative py-12 md:py-16">
    <a href={withBase('/actualites')} class="text-sm font-medium text-blue-900 underline underline-offset-4">Toutes les actualités</a>
    <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-teal-600">{d.categorie} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">{d.titre}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">{d.resume}</p>
    {d.debutEvenement && <p class="mt-5 font-medium">Événement : <time datetime={d.debutEvenement.toISOString()}>{formatDateTime(d.debutEvenement)}</time>{d.finEvenement && <> au <time datetime={d.finEvenement.toISOString()}>{formatDateTime(d.finEvenement)}</time></>}</p>}
  </div></section>
  <section class="py-12 md:py-16"><article class="container-site max-w-prose">
    {d.image && <figure class="mb-8"><img src={withBase(d.image)} alt={d.imageAlt ?? ""} width="960" height="540" class="w-full rounded-2xl" />{d.imageCredit && <figcaption class="mt-2 text-sm text-ink-500">Crédit : {d.imageCredit}</figcaption>}</figure>}
    <EditorialContent entry={actu} />
  </article></section>
</BaseLayout>
