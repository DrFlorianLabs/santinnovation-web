---
import { getCollection } from "astro:content";
import { withBase } from "@lib/paths";
import BaseLayout from "@layouts/BaseLayout.astro";
import EditorialContent from "@components/EditorialContent.astro";
import Icon from "@components/Icon.astro";
import DoctolibButton from "@components/DoctolibButton.astro";

export async function getStaticPaths() {
  const pros = await getCollection("professionnels");
  return pros
    .filter((p) => p.data.visible)
    .map((pro) => ({ params: { slug: pro.id }, props: { pro } }));
}

const { pro } = Astro.props;
const d = pro.data;

const lieux = await getCollection("lieux");
const lieuxDuPro = lieux.filter((l) => d.lieux.includes(l.id));
const activites = d.activites;
const initiales = `${d.prenom[0] ?? ""}${d.nom[0] ?? ""}`.toUpperCase();
---

<BaseLayout
  title={d.titreAffiche}
  description={`${d.titreAffiche}, ${d.professionLabel} — Maisons de Santé Pluriprofessionnelles Sant'Innovation, Besançon.`}
  noindex={d.profession === "a-confirmer"}
>
  <section class="relative overflow-hidden border-b border-blue-100">
    <div class="aurora opacity-60" aria-hidden="true"></div>
    <div class="container-site relative py-12 md:py-16">
      <a
        href={withBase("/equipe")}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-700 hover:text-teal-600"
      >
        <Icon name="arrow-right" size={15} class="rotate-180" /> Toute l'équipe
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-6">
        {
          d.photo ? (
            <figure class="shrink-0"><img
              src={withBase(d.photo)}
              alt={d.photoAlt || `Portrait de ${d.titreAffiche}`}
              width="112"
              height="112"
              class="h-28 w-28 rounded-2xl object-cover shadow-[var(--shadow-e3)] ring-2 ring-white"
            />{d.photoCredit && <figcaption class="mt-2 max-w-32 text-xs text-ink-500">Crédit : {d.photoCredit}</figcaption>}</figure>
          ) : (
            <span
              class="flex h-28 w-28 items-center justify-center rounded-2xl bg-gradient-to-b from-sage-100 to-sage-500/30 font-display text-3xl font-semibold text-sage-700 shadow-[var(--shadow-e2)] ring-2 ring-white"
              aria-hidden="true"
            >
              {initiales}
            </span>
          )
        }
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-teal-600">
            {d.professionLabel}
          </p>
          <h1 class="mt-1 text-3xl font-semibold sm:text-4xl">{d.titreAffiche}</h1>
          {
            lieuxDuPro.length > 0 && (
              <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-700">
                {lieuxDuPro.map((l) => (
                  <span class="inline-flex items-center gap-1.5">
                    <span class="text-sage-500">
                      <Icon name="map-pin" size={15} />
                    </span>
                    {l.data.nom} — {l.data.adresse}
                  </span>
                ))}
              </p>
            )
          }
        </div>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        {d.doctolibUrl && <DoctolibButton href={d.doctolibUrl} size="lg" label={`Rendez-vous avec ${d.titreAffiche}`} />}
        {
          d.accepteNouveauxPatients && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-sage-100 px-3.5 py-1.5 text-sm font-medium text-sage-700 ring-1 ring-sage-500/30">
              <Icon name="check" size={15} /> Accepte de nouveaux patients
            </span>
          )
        }
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-site grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <article class="prose-custom max-w-prose text-ink-950">
        <EditorialContent entry={pro} />
      </article>

      <aside class="space-y-5">
        {activites.length > 0 && <div class="surface p-5"><h2 class="text-xl font-semibold">Activités proposées</h2><ul class="mt-3 space-y-2 text-sm">{activites.map(a => <li class="text-ink-700">{a}</li>)}</ul></div>}
        <div class="surface p-5">
          <h2 class="text-xl font-semibold">Lieux et horaires</h2>
          <ul class="mt-4 space-y-4 text-sm">{lieuxDuPro.map(l => {
            const horaires = d.horairesParLieu?.find(h => h.lieu === l.id)?.horaires;
            const direction = l.data.itineraireUrl ?? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${l.data.adresse}, ${l.data.codePostal} ${l.data.ville}`)}`;
            return <li><a href={withBase(`/lieux/${l.id}`)} class="font-semibold underline underline-offset-4">{l.data.nom}</a><p class="mt-1 text-ink-700">{l.data.adresse}, {l.data.codePostal} {l.data.ville}</p><p class="mt-2 whitespace-pre-line text-ink-700">{horaires || 'Horaires à consulter auprès du professionnel.'}</p><a href={direction} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block font-medium text-teal-600 underline">Itinéraire vers {l.data.nom}</a></li>;
          })}</ul>
          {d.telephone && <p class="mt-4 text-sm"><a href={`tel:${d.telephone.replace(/[^+0-9]/g, '')}`} class="font-medium underline">{d.telephone}</a></p>}
          {d.email && <p class="mt-3 break-all text-sm"><a href={`mailto:${d.email}`} class="font-medium underline">{d.email}</a></p>}
          {d.email && <p class="mt-2 text-xs text-ink-700">Contact professionnel uniquement. N'envoyez aucune information médicale par e-mail.</p>}
        </div>
        {
          d.domaines.length > 0 && (
            <div class="surface p-5">
              <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-blue-900">
                Domaines d'exercice
              </h2>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {d.domaines.map((tag) => (
                  <li class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-700">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="surface p-5">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-blue-900">
            En pratique
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-ink-700">
            {d.doctolibUrl && <li class="flex items-start gap-2">
              <span class="mt-0.5 text-teal-600"><Icon name="calendar" size={15} /></span>
              Rendez-vous en ligne via la fiche Doctolib du professionnel.
            </li>}
            {
              d.soinsADomicile && (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 text-teal-600">
                    <Icon name="map-pin" size={15} />
                  </span>
                  Soins à domicile selon secteur et disponibilités.
                </li>
              )
            }
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-warning"><Icon name="alert-triangle" size={15} /></span>
              En cas d'urgence vitale : 15 ou 112.
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-custom :global(p) {
    margin-block: 1em;
    line-height: 1.7;
  }
  .prose-custom :global(h2) {
    margin-top: 1.6em;
    font-size: 1.35rem;
  }
</style>
