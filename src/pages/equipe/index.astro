---
import { getCollection } from 'astro:content';
import { professionOptions, professionalRoleIDs, professionalSearchText } from '@lib/directory';
import EditorialContent from "@components/EditorialContent.astro";
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ProfessionalCard from '@components/ProfessionalCard.astro';
const lieux = (await getCollection('lieux')).sort((a,b) => a.data.ordre-b.data.ordre);
const lieuxLabels = Object.fromEntries(lieux.map((l) => [l.id, l.data.nom]));
const pros = (await getCollection('professionnels')).filter((p) => p.data.visible).sort((a,b) => a.data.ordre-b.data.ordre);
const professions = professionOptions(pros.map(p => p.data));
const page = (await getCollection("pages")).find(p => p.id === "equipe");
---
<BaseLayout title="L'équipe" description="Trouvez un professionnel Sant'Innovation à Besançon, ses lieux de consultation, ses horaires et ses modalités de rendez-vous.">
  <PageHero eyebrow="Votre professionnel" title="L'équipe pluriprofessionnelle" description="Retrouvez les lieux de consultation, les horaires et les modalités de rendez-vous de chaque professionnel." />
  <section class="py-12 md:py-16">
    <div class="container-site" data-directory>
      {page && <div class="mb-8 max-w-prose"><EditorialContent entry={page} /></div>}
      <form class="surface mb-8 grid gap-4 p-5 md:grid-cols-3" data-filters hidden role="search" aria-label="Filtrer les professionnels">
        <div><label for="pro-name" class="block text-sm font-semibold">Nom ou compétence</label><input id="pro-name" type="search" autocomplete="off" class="filter-input" placeholder="Rechercher un professionnel" /></div>
        <div><label for="pro-profession" class="block text-sm font-semibold">Profession</label><select id="pro-profession" class="filter-input"><option value="">Toutes les professions</option>{professions.map(([id,label])=><option value={id}>{label}</option>)}</select></div>
        <div><label for="pro-lieu" class="block text-sm font-semibold">Lieu de consultation</label><select id="pro-lieu" class="filter-input"><option value="">Tous les lieux</option>{lieux.map(l=><option value={l.id}>{l.data.nom}</option>)}</select></div>
      </form>
      <p class="mb-5 text-sm text-ink-700" role="status" aria-live="polite" data-results>{pros.length} professionnel{pros.length > 1 ? 's' : ''}</p>
      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pros.map(pro => <li data-pro data-name={professionalSearchText(pro.data)} data-professions={JSON.stringify(professionalRoleIDs(pro.data))} data-lieux={JSON.stringify(pro.data.lieux)}><ProfessionalCard pro={pro} lieuxLabels={lieuxLabels} heading="h2" /></li>)}
      </ul>
      <p data-empty hidden class="surface p-6">Aucun professionnel ne correspond à ces critères. Essayez une autre recherche.</p>
      {pros.length === 0 && <p>Les fiches de l'équipe seront affichées après validation.</p>}
      <noscript><p class="mt-5 text-sm text-ink-700">Tous les professionnels sont affichés. Les filtres nécessitent JavaScript ; les fiches et les rendez-vous restent accessibles.</p></noscript>
    </div>
  </section>
</BaseLayout>
<script src="../../scripts/directory.ts"></script>
