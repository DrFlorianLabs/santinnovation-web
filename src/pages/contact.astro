---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import Icon from "@components/Icon.astro";
import EmergencyNotice from "@components/EmergencyNotice.astro";
import { site } from "@data/site";
import { getCollection } from "astro:content";
import EditorialContent from "@components/EditorialContent.astro";
import DoctolibButton from "@components/DoctolibButton.astro";
const page = (await getCollection("pages")).find(p => p.id === "contact");

const contacts = [
  {
    label: "Contact général",
    email: site.contact.general,
    desc: "Questions générales sur l'organisation et le site.",
  },
  {
    label: "Secrétariat",
    email: site.contact.secretariat,
    desc: "Questions administratives non urgentes. Pas de demande médicale par e-mail.",
  },
  {
    label: "Coordination",
    email: site.contact.coordination,
    desc: "Professionnels, partenaires et institutions.",
  },
].filter(c => c.email);
---

<BaseLayout
  title="Contact"
  description="Contacter les Maisons de Santé Pluriprofessionnelles Sant'Innovation à Besançon. Pour toute urgence médicale : 15 ou 112."
>
  <PageHero
    eyebrow="Nous écrire"
    title="Contact"
    description="Pour un rendez-vous, utilisez Doctolib. Aucune demande médicale ne doit transiter par e-mail."
  />

  <section class="py-12 md:py-16">
    <div class="container-site">
      <EditorialContent entry={page} />
      {(site.telephone || site.adresse || site.horaires || site.liens.length > 0) && <div class="surface mb-8 p-6"><h2 class="text-xl font-semibold">Coordonnées de la MSP</h2><dl class="mt-4 space-y-3 text-sm">
        {site.telephone && <div><dt class="font-semibold">Téléphone</dt><dd><a href={`tel:${site.telephone.replace(/[^+0-9]/g, '')}`} class="underline">{site.telephone}</a></dd></div>}
        {site.adresse && <div><dt class="font-semibold">Adresse de contact</dt><dd class="whitespace-pre-line">{site.adresse}</dd></div>}
        {site.horaires && <div><dt class="font-semibold">Horaires</dt><dd class="whitespace-pre-line">{site.horaires}</dd></div>}
      </dl>{site.liens.length > 0 && <ul class="mt-5 space-y-2 text-sm">{site.liens.map(l => <li><a href={l.url} target="_blank" rel="noopener noreferrer" class="font-medium text-teal-600 underline">{l.libelle} — nouvelle fenêtre</a></li>)}</ul>}</div>}
      {contacts.length === 0 && <div class="surface mb-6 p-6"><h2 class="text-xl font-semibold">Joindre votre professionnel</h2><p class="mt-3 text-ink-700">Les coordonnées générales de la MSP sont en cours de vérification. Retrouvez les modalités de contact et de rendez-vous auprès de votre professionnel sur Doctolib.</p><div class="mt-5"><DoctolibButton label="Consulter Doctolib" /></div></div>}
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          contacts.map((c) => (
            <div class="surface p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-b from-teal-100 to-teal-500/20 text-teal-600 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)]">
                <Icon name="phone" size={19} />
              </span>
              <h2 class="mt-3 font-display text-lg font-semibold text-blue-900">{c.label}</h2>
              <a
                href={`mailto:${c.email}`}
                class="mt-1 block break-all font-medium text-teal-600 hover:text-blue-900"
              >
                {c.email}
              </a>
              <p class="mt-2 text-sm text-ink-700">{c.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <EmergencyNotice />
      </div>
    </div>
  </section>
</BaseLayout>
