---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import Icon from "@components/Icon.astro";
import EmergencyNotice from "@components/EmergencyNotice.astro";
import { site } from "@data/site";

const contacts = [
  {
    label: "Contact général",
    email: site.contact.general,
    desc: "Questions générales sur l'organisation et le site.",
  },
  {
    label: "Secrétariat",
    email: site.contact.secretariat,
    desc: "Questions administratives non urgentes. Pas de demande médicale par e-mail.",
  },
  {
    label: "Coordination",
    email: site.contact.coordination,
    desc: "Professionnels, partenaires et institutions.",
  },
];
---

<BaseLayout
  title="Contact"
  description="Contacter les Maisons de Santé Pluriprofessionnelles Sant'Innovation à Besançon. Pour toute urgence médicale : 15 ou 112."
>
  <PageHero
    eyebrow="Nous écrire"
    title="Contact"
    description="Pour un rendez-vous, utilisez Doctolib. Aucune demande médicale ne doit transiter par e-mail."
  />

  <section class="py-12 md:py-16">
    <div class="container-site">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          contacts.map((c) => (
            <div class="surface p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-b from-teal-100 to-teal-500/20 text-teal-600 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)]">
                <Icon name="phone" size={19} />
              </span>
              <h2 class="mt-3 font-display text-lg font-semibold text-blue-900">{c.label}</h2>
              <a
                href={`mailto:${c.email}`}
                class="mt-1 block break-all font-medium text-teal-600 hover:text-blue-900"
              >
                {c.email}
              </a>
              <p class="mt-2 text-sm text-ink-700">{c.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <EmergencyNotice />
      </div>
    </div>
  </section>
</BaseLayout>
