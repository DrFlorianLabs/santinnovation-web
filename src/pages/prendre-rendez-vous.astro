---
import { withBase } from "@lib/paths";
import { getCollection } from "astro:content";
import EditorialContent from "@components/EditorialContent.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import DoctolibButton from "@components/DoctolibButton.astro";
import EmergencyNotice from "@components/EmergencyNotice.astro";

const pros = (await getCollection("professionnels"))
  .filter((p) => p.data.visible && p.data.profession !== "a-confirmer")
  .sort((a, b) => a.data.ordre - b.data.ordre);
const page = (await getCollection("pages")).find(p => p.id === "prendre-rendez-vous");
---

<BaseLayout
  title="Prendre rendez-vous"
  description="Prendre rendez-vous avec un professionnel de Sant'Innovation à Besançon : en ligne via Doctolib, 24h/24, ou par téléphone auprès de chaque cabinet."
>
  <PageHero
    eyebrow="En ligne, 24h/24"
    title="Prendre rendez-vous"
    description="Le plus simple : la fiche établissement Sant'Innovation sur Doctolib. Vous pouvez aussi réserver directement auprès d'un professionnel."
  >
    <div class="mt-6">
      <DoctolibButton size="lg" label="Ouvrir Doctolib Sant'Innovation" />
    </div>
  </PageHero>

  <section class="py-12 md:py-16">
    <div class="container-site">
      {page && <div class="mb-8 max-w-prose"><EditorialContent entry={page} /></div>}
      <h2 class="text-2xl font-semibold sm:text-3xl">Directement avec un professionnel</h2>
      {/* grid-cols-1 explicite : la piste implicite prendrait sinon la largeur
          min-content des libellés truncate (débordement mobile, AUD-013). */}
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          pros.filter(pro => pro.data.doctolibUrl).map((pro) => (
            <li class="surface flex flex-wrap items-center gap-4 p-4">
              <span class="min-w-0 flex-1">
                <a href={withBase(`/equipe/${pro.id}`)} class="block font-display font-semibold text-blue-900 hover:underline">
                  {pro.data.titreAffiche}
                </a>
                <span class="block text-sm text-teal-600">{pro.data.professionLabel}</span>
              </span>
              <DoctolibButton
                href={pro.data.doctolibUrl}
                label="Rendez-vous"
                ariaLabel={`Prendre rendez-vous avec ${pro.data.titreAffiche} sur Doctolib`}
                variant="primary"
              />
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-sm text-ink-500">
        Seuls les professionnels disposant d’un lien individuel vérifié figurent ici.
        Vérifiez le professionnel et le lieu avant de réserver. <a href={withBase('/#equipe')} class="underline">Consulter toute l’équipe</a>.
      </p>

      <div class="mt-12">
        <EmergencyNotice />
      </div>
    </div>
  </section>
</BaseLayout>
