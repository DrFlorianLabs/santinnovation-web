---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { getCollection } from "astro:content";
import EditorialContent from "@components/EditorialContent.astro";
const page = (await getCollection("pages")).find(p => p.id === "confidentialite");

/**
 * Politique de confidentialité — trame article 13 RGPD.
 * Les champs « À COMPLÉTER » exigent une validation juridique/DPO avant
 * mise en production (cf. docs/PLAN_ACTION.md, phase 0 et 2).
 */
---

<BaseLayout
  title="Politique de confidentialité"
  description="Traitements de données personnelles du site Sant'Innovation : finalités, bases légales, destinataires, durées et droits (RGPD)."
>
  <PageHero
    eyebrow="RGPD"
    title="Politique de confidentialité"
    description="Ce que le site fait — et ne fait pas — de vos données personnelles."
  />

  <section class="py-12 md:py-16">
    {page ? <div class="container-site max-w-prose"><EditorialContent entry={page} /></div> : <>
    <div class="container-site max-w-prose space-y-10">
      <div>
        <h2 class="text-2xl font-semibold">Responsable de traitement</h2>
        <p class="mt-3 text-ink-700">
          <strong>[À COMPLÉTER : dénomination de la personne morale éditrice]</strong>,
          représentée par <strong>[À COMPLÉTER]</strong>.
          Contact données personnelles / DPO :
          <strong>[À COMPLÉTER : contact DPO ou référent RGPD]</strong>.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-semibold">Ce que ce site ne fait pas</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-700">
          <li>Aucun compte utilisateur, aucun formulaire de collecte de données médicales.</li>
          <li>Aucun cookie déposé par le site, aucun outil de mesure d'audience.</li>
          <li>Aucune donnée patient : la prise de rendez-vous se fait sur Doctolib.</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-semibold">Traitements effectués</h2>
        <div class="mt-4 overflow-x-auto" tabindex="0" role="region" aria-label="Tableau des traitements de données personnelles">
          <table class="w-full min-w-[36rem] text-left text-sm text-ink-700">
            <thead>
              <tr class="border-b border-blue-100 font-display text-blue-900">
                <th class="py-2 pr-4 font-semibold">Traitement</th>
                <th class="py-2 pr-4 font-semibold">Finalité</th>
                <th class="py-2 pr-4 font-semibold">Base légale</th>
                <th class="py-2 font-semibold">Durée</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-blue-100/70">
              <tr>
                <td class="py-2.5 pr-4">E-mails reçus (contact@, secretariat@…)</td>
                <td class="py-2.5 pr-4">Répondre à vos demandes non médicales</td>
                <td class="py-2.5 pr-4">Intérêt légitime</td>
                <td class="py-2.5">[À COMPLÉTER]</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4">Journaux techniques de l'hébergeur (IP, date)</td>
                <td class="py-2.5 pr-4">Sécurité et fonctionnement du site</td>
                <td class="py-2.5 pr-4">Intérêt légitime</td>
                <td class="py-2.5">[À COMPLÉTER : durée des logs OVH]</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4">Affichage du fond de carte (requêtes vers IGN)</td>
                <td class="py-2.5 pr-4">Afficher la carte des sites</td>
                <td class="py-2.5 pr-4">Intérêt légitime</td>
                <td class="py-2.5">Voir politique IGN</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold">Destinataires et sous-traitants</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-700">
          <li>
            <strong>OVH SAS</strong> (France) — hébergement du site et des e-mails
            <em>[À CONFIRMER pour les e-mails]</em>.
          </li>
          <li>
            <strong>IGN</strong> — fourniture du fond de carte : votre navigateur
            transmet votre adresse IP et des en-têtes techniques aux serveurs de
            IGN lorsque la carte se charge automatiquement à l’approche de la rubrique des lieux. Aucun cookie n'est déposé par ces
            requêtes. <em>[À COMPLÉTER : localisation du traitement et garanties
            de transfert éventuelles.]</em>
          </li>
          <li>
            <strong>Doctolib SAS</strong> — prise de rendez-vous, sur son propre
            site, en qualité de responsable de traitement distinct.
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-semibold">Cookies</h2>
        <p class="mt-3 text-ink-700">
          Le site ne dépose aucun cookie et n'embarque aucun traceur publicitaire ou
          de mesure d'audience ; aucun bandeau de consentement n'est donc requis en
          l'état. Cette analyse devra être revue si un service tiers déposant des
          traceurs était ajouté.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-semibold">Vos droits</h2>
        <p class="mt-3 text-ink-700">
          Vous disposez des droits d'accès, de rectification, d'effacement, de
          limitation et d'opposition sur vos données. Pour les exercer :
          <strong>[À COMPLÉTER : contact DPO / référent]</strong>. Vous pouvez
          également saisir la CNIL (<a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="font-medium text-teal-600 hover:text-blue-900">cnil.fr</a>).
        </p>
        <p class="mt-3 text-ink-700">
          <strong>Important :</strong> n'envoyez jamais d'information médicale par
          e-mail. Pour toute question de santé, prenez rendez-vous ou, en urgence,
          composez le 15 ou le 112.
        </p>
      </div>
    </div>
    </>}
  </section>
</BaseLayout>
