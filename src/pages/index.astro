---
import { getCollection } from 'astro:content';
import { professionOptions, professionalRoleIDs, professionalSearchText } from '@lib/directory';
import { withBase } from '@lib/paths';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import DoctolibButton from '@components/DoctolibButton.astro';
import ProfessionalCard from '@components/ProfessionalCard.astro';
import PartnerStrip from '@components/PartnerStrip.astro';
import Logo from '@components/Logo.astro';
import DecorativeBackdrop from '@components/DecorativeBackdrop.astro';
import EmergencyNotice from '@components/EmergencyNotice.astro';
import SiteMap from '@components/SiteMap.astro';
import CompactNews from '@components/CompactNews.astro';
import InnovationLogo from '@components/InnovationLogo.astro';
import EditorialContent from '@components/EditorialContent.astro';
import { site } from '@data/site';
import { isPublishedArticle } from '@lib/publication';

const lieux = (await getCollection('lieux')).filter(isPublishedArticle).sort((a, b) => a.data.ordre - b.data.ordre);
const lieuxLabels = Object.fromEntries(lieux.map(l => [l.id, l.data.nom]));
const pros = (await getCollection('professionnels')).filter(isPublishedArticle).sort((a, b) => a.data.ordre - b.data.ordre);
const professions = professionOptions(pros.map(p => p.data));
const pages = (await getCollection('pages')).filter(isPublishedArticle);
const accueil = pages.find(p => p.id === 'accueil');
const equipe = pages.find(p => p.id === 'equipe');
const pratique = pages.find(p => p.id === 'lieux');
const projet = pages.find(p => p.id === 'projet-de-sante');
const innovation = pages.find(p => p.id === 'recherche-innovation');
const innovations = (await getCollection('innovations')).filter(isPublishedArticle).sort((a, b) => a.data.ordre - b.data.ordre);
const actualites = (await getCollection('actualites')).filter(isPublishedArticle)
  .sort((a, b) => Number(b.data.epingle) - Number(a.data.epingle) || b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

---

<BaseLayout title="Accueil" description={accueil?.data.resume || site.description}>
  <DecorativeBackdrop />
  <section id="rendez-vous" tabindex="-1" data-home-section aria-labelledby="accueil-title" class="home-scene home-hero relative">
    <div class="home-scene-content container-site grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,.75fr)]">
      <div class="min-w-0">
        <p class="home-kicker text-sm font-semibold uppercase tracking-wider text-teal-600">Maison de santé pluriprofessionnelle · {site.ville}</p>
        <h1 id="accueil-title" class="mt-4 max-w-3xl hyphens-auto text-4xl font-semibold sm:text-5xl">{accueil?.data.titre || 'Votre équipe de santé, au plus près de vous.'}</h1>
        <p class="mt-5 max-w-2xl text-lg text-ink-700">{accueil?.data.resume || site.description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <DoctolibButton size="lg" label="Prendre rendez-vous" />
          <a href="#equipe" class="btn-3d btn-3d-secondary inline-flex items-center gap-2 rounded-xl px-5 py-3.5 font-medium text-blue-900">Trouver un professionnel <Icon name="arrow-right" size={18} /></a>
        </div>
        <p class="mt-4 text-sm text-ink-700">Les modalités et disponibilités sont précisées sur la fiche de chaque professionnel.</p>
        <a href="#lieux" class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-teal-600 underline underline-offset-4 lg:hidden"><Icon name="map-pin" size={16} />Adresses, horaires et accès</a>
        {accueil && <div class="home-editorial mt-5 max-w-prose text-sm"><EditorialContent entry={accueil} /></div>}
      </div>
      <aside aria-label="Les lieux de consultation" class="home-visit hidden min-w-0 lg:block">
        <div class="flex items-center gap-4"><Logo size={56} /><div class="min-w-0"><p class="font-display text-xl font-semibold text-blue-900">{site.nomCourt}</p><p class="mt-1 text-sm text-ink-700">{site.baseline}</p></div></div>
        <p class="mt-6 text-sm font-semibold text-blue-900">Préparer votre venue</p>
        <ul class="mt-2 divide-y divide-blue-100">
          {lieux.map(lieu => <li><a href={`#lieu-${lieu.id}`} class="flex items-center gap-3 py-3 text-sm hover:underline"><Icon name="map-pin" size={18} /><span class="min-w-0 flex-1"><span class="block font-semibold text-blue-900">{lieu.data.nom}</span><span class="block text-ink-700">{lieu.data.secteur || lieu.data.ville}</span></span><Icon name="arrow-right" size={16} /></a></li>)}
        </ul>
        {lieux.length === 0 && <p class="mt-3 text-sm text-ink-700">Les lieux de consultation seront présentés après validation.</p>}
        <a href="#lieux" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-teal-600 underline underline-offset-4">Adresses, horaires et accès <Icon name="arrow-right" size={16} /></a>
      </aside>
    </div>
  </section>

  <CompactNews actualites={actualites} />

  <section id="equipe" tabindex="-1" data-home-section aria-labelledby="equipe-title" class="home-scene home-section py-12 md:py-16">
    <div class="home-scene-content container-site" data-directory>
      <div class="home-section-heading max-w-prose"><p class="home-kicker text-sm font-semibold uppercase tracking-wider text-teal-600">Votre professionnel</p><h2 id="equipe-title" class="mt-3 text-3xl font-semibold sm:text-4xl">L’équipe</h2><p class="mt-4 text-ink-700">{equipe?.data.resume || 'Retrouvez tous les professionnels, leurs lieux de consultation et leurs modalités de rendez-vous.'}</p></div>
      {equipe && <div class="home-editorial mt-4 max-w-prose"><EditorialContent entry={equipe} /></div>}
      <form class="home-filters mt-7 grid gap-4 py-5 md:grid-cols-3" data-filters hidden role="search" aria-label="Filtrer les professionnels">
        <div><label for="pro-name" class="block text-sm font-semibold">Nom ou compétence</label><input id="pro-name" type="search" autocomplete="off" class="filter-input" placeholder="Rechercher un professionnel" /></div>
        <div><label for="pro-profession" class="block text-sm font-semibold">Profession</label><select id="pro-profession" class="filter-input"><option value="">Toutes les professions</option>{professions.map(([id, label]) => <option value={id}>{label}</option>)}</select></div>
        <div><label for="pro-lieu" class="block text-sm font-semibold">Lieu de consultation</label><select id="pro-lieu" class="filter-input"><option value="">Tous les lieux</option>{lieux.map(lieu => <option value={lieu.id}>{lieu.data.nom}</option>)}</select></div>
      </form>
      <p class="mb-5 mt-5 text-sm text-ink-700" role="status" aria-live="polite" data-results>{pros.length} professionnel{pros.length > 1 ? 's' : ''}</p>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pros.map(pro => <li data-pro data-name={professionalSearchText(pro.data)} data-professions={JSON.stringify(professionalRoleIDs(pro.data))} data-lieux={JSON.stringify(pro.data.lieux)}><ProfessionalCard pro={pro} lieuxLabels={lieuxLabels} heading="h3" variant="plain" /></li>)}
      </ul>
      <p data-empty hidden class="py-6">Aucun professionnel ne correspond à ces critères. Essayez une autre recherche.</p>
      {pros.length === 0 && <p>Les fiches de l’équipe seront affichées après validation.</p>}
      <noscript><p class="mt-5 text-sm text-ink-700">Tous les professionnels sont affichés. Les filtres nécessitent JavaScript ; les fiches et les rendez-vous restent accessibles.</p></noscript>
    </div>
  </section>

  <section id="lieux" tabindex="-1" data-home-section aria-labelledby="lieux-title" class="home-scene home-section home-locations py-12 md:py-16">
    <div class="home-scene-content container-site">
      <div class="home-section-heading max-w-prose"><p class="home-kicker text-sm font-semibold uppercase tracking-wider text-teal-600">Préparer votre consultation</p><h2 id="lieux-title" class="mt-3 text-3xl font-semibold sm:text-4xl">Nos lieux de consultation</h2><p class="mt-4 text-ink-700">{pratique?.data.resume || 'Vérifiez le lieu indiqué dans votre rendez-vous : un professionnel peut consulter dans plusieurs établissements.'}</p></div>
      {pratique && <div class="home-editorial mt-4 max-w-prose"><EditorialContent entry={pratique} /></div>}
      {lieux.length > 0 ? <div class="home-map mt-8"><SiteMap lieux={lieux} id="carte-accueil" /></div> : <p class="mt-5 text-ink-700">Les informations des établissements seront disponibles après validation.</p>}
    </div>
  </section>

  <section id="soins-et-parcours" tabindex="-1" data-home-section aria-labelledby="soins-title" class="home-scene home-section home-care py-12 md:py-16">
    <div class="home-scene-content container-site">
      <h2 id="soins-title" class="text-3xl font-semibold sm:text-4xl">Soins et parcours</h2>
    </div>
  </section>

  <section id="projet-de-sante" tabindex="-1" data-home-section aria-labelledby="projet-title" class="home-scene home-section home-project py-16 md:py-24">
    <div class="home-scene-content container-site home-editorial-layout">
      <div class="home-section-heading"><p class="home-kicker text-sm font-semibold uppercase tracking-wider text-teal-600">Notre organisation collective</p><h2 id="projet-title" class="mt-3 text-3xl font-semibold sm:text-4xl">Le projet de santé</h2>{projet?.data.resume && <p class="mt-5 text-lg text-ink-700">{projet.data.resume}</p>}</div>
      <div class="home-editorial max-w-prose">
        <EditorialContent entry={projet}><p>La présentation du projet de santé sera publiée ici après validation par l’équipe.</p></EditorialContent>
        {projet?.data.image && <figure class="mt-8"><img src={withBase(projet.data.image)} alt={projet.data.imageAlt || ''} width="960" height="540" loading="lazy" class="aspect-video w-full object-cover" />{projet.data.imageCredit && <figcaption class="mt-2 text-sm text-ink-700">Crédit : {projet.data.imageCredit}</figcaption>}</figure>}
      </div>
    </div>
  </section>

  <section id="recherche-innovation" tabindex="-1" data-home-section aria-labelledby="innovation-title" class="home-scene home-section home-innovation py-16 md:py-24">
    <div class="home-scene-content container-site home-editorial-layout">
      <div class="home-section-heading"><p class="home-kicker text-sm font-semibold uppercase tracking-wider text-teal-600">Innovation utile</p><h2 id="innovation-title" class="mt-3 text-3xl font-semibold sm:text-4xl">Recherche et innovation</h2>{innovation?.data.resume && <p class="mt-5 text-lg text-ink-700">{innovation.data.resume}</p>}</div>
      <div class="home-editorial">
        <div class="max-w-prose"><EditorialContent entry={innovation}><p>Les projets de recherche et d’innovation sont présentés après validation par l’équipe, avec leur contexte et leur état d’avancement.</p></EditorialContent></div>
        {innovations.length > 0 && <ul class="home-project-list mt-8">{innovations.map(item => <li class="home-project-item py-7"><InnovationLogo id={item.id} /><h3 class="text-xl font-semibold"><a href={withBase(`/innovations/${item.id}`)} class="hover:underline">{item.data.titre}</a></h3><p class="mt-3 text-ink-700">{item.data.resume}</p><a href={withBase(`/innovations/${item.id}`)} class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-teal-600 underline underline-offset-4">Découvrir le projet <Icon name="arrow-right" size={16} /></a></li>)}</ul>}
      </div>
    </div>
  </section>

  <PartnerStrip title="Nos partenaires" />
  <div class="home-scene-content container-site pb-8"><EmergencyNotice /></div>
</BaseLayout>

<script src="../scripts/directory.ts"></script>
