---
import { getCollection } from "astro:content";
import { withBase } from "@lib/paths";
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import DoctolibButton from "@components/DoctolibButton.astro";
import ProfessionalCard from "@components/ProfessionalCard.astro";
import PartnerStrip from "@components/PartnerStrip.astro";
import Logo from "@components/Logo.astro";
import EmergencyNotice from "@components/EmergencyNotice.astro";
import SiteMap from "@components/SiteMap.astro";
import { doctolib } from "@data/doctolib";
import { site } from "@data/site";
import NewsCard from "@components/NewsCard.astro";
import EditorialContent from "@components/EditorialContent.astro";
import { isPublishedArticle } from "@lib/publication";

const lieux = (await getCollection("lieux")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const lieuxLabels = Object.fromEntries(lieux.map((l) => [l.id, l.data.nom]));

const pros = (await getCollection("professionnels"))
  .filter((p) => p.data.visible)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const prosApercu = pros.slice(0, 6);

const pages = await getCollection("pages");
const accueil = pages.find(p => p.id === "accueil");
const projet = pages.find(p => p.id === "projet-de-sante");
const innovation = pages.find(p => p.id === "recherche-innovation");
const professions = [...new Set(pros.map(p => p.data.professionLabel))];
const actualites = (await getCollection("actualites")).filter(isPublishedArticle).sort((a,b)=>Number(b.data.epingle)-Number(a.data.epingle) || b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---

<BaseLayout
  title="Accueil"
  description="Maisons de Santé Pluriprofessionnelles Sant'Innovation : soins de proximité, coordination pluriprofessionnelle et innovation utile à Besançon."
>
  <!-- ============================================================
       HERO — identité claire : une maison de santé pluriprofessionnelle
       Mise en page 100 % grille (aucun positionnement absolu) :
       pas de chevauchement ni de décalage de texte, à aucune largeur.
       ============================================================ -->
  <section class="relative overflow-hidden">
    {/* data-parallax : glissement de profondeur au scroll (interactions.ts). */}
    <div class="aurora" data-parallax="0.03" aria-hidden="true"></div>
    <div class="dot-field pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
    <div class="depth-grid" aria-hidden="true"></div>

    <div
      class="container-site relative grid grid-cols-1 items-center gap-12 py-16 md:py-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:py-24"
    >
      <!-- Colonne message (min-w-0 : ne jamais élargir la grille au-delà de l'écran) -->
      <div class="reveal min-w-0">
        <p class="flex items-center gap-2.5 text-sm font-semibold uppercase tracking-widest text-blue-700">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-teal-600 shadow-[inset_0_1px_0_rgba(255,255,255,1),0_4px_10px_-3px_rgba(18,50,74,0.25)] ring-1 ring-blue-100"
          >
            <Icon name="cross" size={16} />
          </span>
          Maison de Santé Pluriprofessionnelle · {site.ville}
        </p>

        {/* hyphens-auto : « pluriprofessionnelle » dépasse sinon la largeur
            d'un écran de 320-390 px (mot insécable plus large que la colonne). */}
        <h1 class="mt-5 hyphens-auto text-4xl font-semibold sm:text-5xl lg:text-[3.4rem]">
          {accueil?.data.titre ?? "Une équipe de santé pluriprofessionnelle, coordonnée autour de vos soins."}
        </h1>

        <p class="mt-6 max-w-xl text-lg text-ink-700">
          {accueil?.data.resume ?? site.description}
        </p>

        <!-- Les métiers, lisibles au premier coup d'œil -->
        <ul class="mt-7 flex flex-wrap gap-2.5" aria-label="Professions présentes">
          {
            professions.map((label) => (
              <li
                class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-medium text-blue-900 shadow-[inset_0_1px_0_rgba(255,255,255,1),0_4px_10px_-4px_rgba(18,50,74,0.2)] ring-1 ring-blue-100"
              >
                <span class="text-teal-600">
                  <Icon name="cross" size={15} />
                </span>
                {label}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <DoctolibButton size="lg" label="Prendre rendez-vous" />
          <a
            href={withBase("/equipe")}
            class="btn-3d btn-3d-secondary inline-flex items-center gap-2 rounded-xl px-6 py-3.5 text-lg font-medium text-blue-900"
          >
            Découvrir l'équipe <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <p class="mt-4 text-sm text-ink-500">
          Patients du territoire bisontin, selon les disponibilités de chaque professionnel.
        </p>
      </div>

      <!-- Panneau d'identité : la structure en un regard.
           La parallaxe vit sur .tilt-scene (conteneur dédié) : .reveal
           transitionne déjà transform, les deux ne doivent pas cohabiter. -->
      <div class="reveal hidden md:block" style="--reveal-delay: 120ms">
        <div class="tilt-scene" data-parallax="0.06">
        <div class="tilt surface surface-raised relative overflow-hidden p-6 sm:p-7">
          <span class="tilt-glare" aria-hidden="true"></span>

          <!-- Filigrane réseau (décor discret) -->
          <svg
            viewBox="0 0 200 200"
            class="pointer-events-none absolute -right-10 -top-10 h-44 w-44 opacity-[0.07]"
            fill="none"
            stroke="#12324A"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="60" cy="60" r="14"></circle>
            <circle cx="150" cy="50" r="14"></circle>
            <circle cx="100" cy="150" r="14"></circle>
            <path d="M72 66l64 74M74 56l62-4M146 64l-40 72"></path>
          </svg>

          <div class="tilt-pop-sm relative">
            <div class="flex items-center gap-3">
              <Logo size={52} />
              <div>
                <p class="font-display text-lg font-semibold text-blue-900">
                  {site.nomCourt === "Sant'Innovation" ? <>Sant'<span class="text-brand-gradient">Innovation</span></> : site.nomCourt}
                </p>
                <p class="text-sm text-ink-700">Une organisation · {lieux.length} lieux de consultation</p>
              </div>
            </div>

            <ul class="mt-6 space-y-2.5">
              {
                lieux.map((l) => (
                  <li>
                    <a
                      href={withBase(`/lieux/${l.id}`)}
                      class="group/site flex items-center gap-3 rounded-xl bg-ivory px-3.5 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] ring-1 ring-blue-100/70 transition-all duration-200 hover:bg-teal-100/50 hover:ring-teal-600/40"
                      aria-label={`${l.data.nom} — adresse et accès`}
                    >
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-teal-600 shadow-[0_3px_8px_-3px_rgba(18,50,74,0.25)]">
                        <Icon name="map-pin" size={16} />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-semibold text-blue-900">
                          {l.data.nom}
                        </span>
                        <span class="block text-xs text-ink-700">
                          {l.data.secteur ?? l.data.adresse}
                        </span>
                      </span>
                      <span class="text-xs font-medium text-teal-600 opacity-0 transition-opacity duration-200 group-hover/site:opacity-100">
                        Voir le lieu
                      </span>
                      <span class="text-ink-500 transition-transform duration-200 group-hover/site:translate-x-0.5">
                        <Icon name="chevron-right" size={15} />
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-6 grid grid-cols-3 divide-x divide-blue-100 rounded-xl bg-ivory py-3 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.9)] ring-1 ring-blue-100/70">
              <div>
                <p class="font-display text-2xl font-semibold text-blue-900">{lieux.length}</p>
                <p class="text-xs text-ink-700">lieux de soins</p>
              </div>
              <div>
                <p class="font-display text-2xl font-semibold text-blue-900">{professions.length}</p>
                <p class="text-xs text-ink-700">métiers</p>
              </div>
              <div>
                <p class="font-display text-2xl font-semibold text-teal-600">1</p>
                <p class="text-xs text-ink-700">coordination</p>
              </div>
            </div>

            <p class="mt-5 flex items-center gap-2 text-sm text-ink-700">
              <span class="text-teal-600"><Icon name="calendar" size={16} /></span>
              Rendez-vous en ligne via Doctolib, ou par téléphone auprès de chaque cabinet.
            </p>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  {accueil && <section class="border-y border-blue-100 bg-white py-12"><div class="container-site max-w-prose"><EditorialContent entry={accueil} /></div></section>}

  <!-- ============================================================
       PRENDRE RDV — un seul grand pavé, clic direct vers Doctolib
       ============================================================ -->
  <section class="py-16 md:py-20">
    <div class="container-site">
      <a
        href={doctolib.etablissement}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group relative block overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 via-blue-950 to-[#0a2438] px-6 py-12 text-white shadow-[var(--shadow-e4)] transition-transform duration-300 hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-500 sm:px-12 sm:py-16"
        aria-label="Prendre rendez-vous — ouvre la fiche Sant'Innovation sur Doctolib"
      >
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-500/70 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-teal-500/20 blur-3xl transition-transform duration-500 group-hover:scale-125"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -bottom-32 -left-16 h-72 w-72 rounded-full bg-sage-500/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex flex-wrap items-center justify-between gap-8">
          <div class="max-w-2xl">
            <p class="flex items-center gap-2 text-sm font-medium uppercase tracking-widest text-teal-500">
              <Icon name="calendar" size={16} /> En ligne, 24h/24
            </p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-5xl">
              Prendre rendez-vous
            </h2>
            <p class="mt-4 text-white/80">
              Accédez directement à la fiche Sant'Innovation sur Doctolib et choisissez
              votre professionnel et votre créneau.
            </p>
          </div>
          <span
            class="btn-3d btn-3d-primary inline-flex items-center gap-3 rounded-2xl px-8 py-5 text-xl font-semibold text-white"
            aria-hidden="true"
          >
            Ouvrir Doctolib
            <Icon name="arrow-right" size={24} class="transition-transform duration-300 group-hover:translate-x-1" />
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ============================================================
       ÉQUIPE
       ============================================================ -->
  <section class="py-4 md:py-8">
    <div class="container-site">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-prose">
          <h2 class="text-3xl font-semibold sm:text-4xl">L'équipe</h2>
          <p class="mt-3 text-ink-700">
            Trouvez un professionnel par son nom, sa profession ou son lieu de consultation,
            puis consultez sa fiche pour préparer votre rendez-vous.
          </p>
        </div>
        <a
          href={withBase("/equipe")}
          class="inline-flex items-center gap-2 font-medium text-blue-900 hover:text-teal-600"
        >
          Voir toute l'équipe <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          prosApercu.map((pro, i) => (
            <div class="reveal h-full" style={`--reveal-delay: ${(i % 3) * 90}ms`}>
              <ProfessionalCard pro={pro} lieuxLabels={lieuxLabels} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       SITES
       ============================================================ -->
  <section class="py-16 md:py-20">
    <div class="container-site">
      <div class="reveal max-w-prose">
        <h2 class="text-3xl font-semibold sm:text-4xl">Plusieurs lieux, une même coordination</h2>
        <p class="mt-3 text-ink-700">
          Chaque professionnel peut exercer sur un ou plusieurs sites. Les modalités sont
          précisées sur chaque fiche.
        </p>
      </div>
      <div class="reveal mt-8">
        <SiteMap lieux={lieux} id="carte" />
      </div>
      <p class="mt-6 text-sm text-ink-500">
        Sant'Innovation accueille les patients du quartier, des secteurs voisins et plus
        largement du territoire bisontin, selon les disponibilités de chaque professionnel.
      </p>
    </div>
  </section>

  <!-- ============================================================
       PROJET DE SANTÉ + RECHERCHE — section profonde
       ============================================================ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-950 via-blue-900 to-blue-950 py-16 text-white md:py-24">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-500/50 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="dot-field pointer-events-none absolute inset-0 opacity-[0.12] invert"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-32 top-1/3 h-96 w-96 rounded-full bg-blue-500/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="reveal glass-dark rounded-3xl p-8">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-teal-500 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
        >
          <Icon name="route" size={22} />
        </span>
        <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl">Notre projet de santé</h2>
        <p class="mt-4 text-white/80">
          {projet?.data.resume ?? "Notre organisation collective autour de la coordination entre professionnels, des parcours de soins et de la prévention."}
        </p>
        <a
          href={withBase("/projet-de-sante")}
          class="mt-6 inline-flex items-center gap-2 font-medium text-teal-500 hover:text-white"
        >
          Découvrir le projet <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="reveal glass-dark rounded-3xl p-8" style="--reveal-delay: 110ms">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-teal-500 shadow-[inset_0_1px_0_rgba(255,255,255,0.15)]"
        >
          <Icon name="sparkles" size={22} />
        </span>
        <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl">Recherche & innovation</h2>
        <p class="mt-4 text-white/80">
          {innovation?.data.resume ?? "Une démarche d’innovation technologique et organisationnelle, au service des parcours de soins."}
        </p>
        <a
          href={withBase("/recherche-innovation")}
          class="mt-6 inline-flex items-center gap-2 font-medium text-teal-500 hover:text-white"
        >
          Nos axes et projets <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>

  </section>

  <section class="py-14"><div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><h2 class="text-3xl font-semibold">Actualités et prévention</h2><p class="mt-3 text-ink-700">Les dernières informations publiées par Sant'Innovation.</p></div><a href={withBase('/actualites')} class="font-medium text-teal-600 underline underline-offset-4">Toutes les actualités</a></div>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">{actualites.map(actu => <li><NewsCard actu={actu} heading="h3" /></li>)}</ul>
    {actualites.length === 0 && <p class="mt-6 text-ink-700">Les prochaines actualités de la MSP seront disponibles ici.</p>}
  </div></section>

  <!-- PARTENAIRES -->
  <PartnerStrip title="Un écosystème territorial, universitaire et institutionnel" />

  <!-- URGENCE -->
  <section class="pb-8">
    <div class="container-site">
      <EmergencyNotice />
    </div>
  </section>
</BaseLayout>
