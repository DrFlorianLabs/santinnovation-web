---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import Logo from "@components/Logo.astro";
import {
  documents,
  auditLog,
  ROLES,
  ROLE_LABELS,
  SENSITIVITY_LABELS,
  CATEGORY_LABELS,
  ACTION_LABELS,
} from "@data/pro";
import { formatDate } from "@lib/format";

const badgeStyles = {
  interne: "bg-sage-100 text-sage-700 ring-sage-500/30",
  restreint: "bg-warning/15 text-[#8a6114] ring-warning/40",
  sensible: "bg-danger/10 text-danger ring-danger/30",
} as const;

const formatIcones = {
  pdf: "file-text",
  docx: "file-text",
  xlsx: "database",
  md: "file-text",
} as const;
---

<BaseLayout
  title="Espace professionnel — Bibliothèque documentaire"
  description="Espace professionnel Sant'Innovation : bibliothèque documentaire interne avec rôles, permissions et traçabilité (démonstration)."
  noindex
  chrome="pro"
>
  <div class="relative min-h-screen overflow-hidden bg-blue-950 pb-16 text-white">
    <div
      class="dot-field pointer-events-none absolute inset-0 opacity-[0.1] invert"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-40 left-1/3 h-96 w-[50rem] -translate-x-1/2 rounded-full bg-teal-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <!-- Barre pro -->
    <header class="glass-dark sticky top-0 z-40 border-b border-white/10">
      <div class="container-site flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5" style="--logo-house: #ffffff" aria-label="Sant'Innovation — retour au site public">
          <Logo size={40} static />
          <span class="hidden font-display text-lg font-semibold text-white sm:inline">
            Sant'<span class="text-brand-gradient">Innovation</span>
          </span>
          <span
            class="rounded-full bg-white/10 px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-teal-500 ring-1 ring-white/15"
          >
            Espace pro
          </span>
        </a>

        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-sm text-white/70">
            <span class="hidden sm:inline">Rôle simulé</span>
            <select
              id="role-select"
              class="rounded-lg border border-white/15 bg-blue-900 px-2.5 py-1.5 text-sm font-medium text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] focus-visible:outline-2 focus-visible:outline-teal-500"
            >
              {ROLES.map((r) => (
                <option value={r} selected={r === "professional"}>
                  {ROLE_LABELS[r]}
                </option>
              ))}
            </select>
          </label>
          <a
            href="/"
            class="hidden items-center gap-1.5 text-sm font-medium text-white/70 transition-colors hover:text-white md:inline-flex"
          >
            <Icon name="arrow-right" size={15} class="rotate-180" /> Site public
          </a>
        </div>
      </div>
    </header>

    <div class="container-site relative">
      <!-- Bandeau démonstration -->
      <div
        class="mt-6 flex items-start gap-3 rounded-2xl bg-warning/10 p-4 text-sm text-white/85 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] ring-1 ring-warning/30"
        role="note"
      >
        <span class="mt-0.5 shrink-0 text-warning"><Icon name="shield-alert" size={18} /></span>
        <p>
          <strong class="font-semibold text-white">Environnement de démonstration.</strong>
          Authentification et permissions simulées côté client. Aucune donnée réelle :
          aucun document patient, aucun élément financier, aucun secret. La GED de
          production (V1.5) reposera sur une authentification forte, un contrôle d'accès
          serveur et une traçabilité complète.
        </p>
      </div>

      <!-- En-tête -->
      <div class="reveal mt-10 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-widest text-teal-500">
            Bibliothèque documentaire · GED interne
          </p>
          <h1 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">
            Documents de l'organisation
          </h1>
          <p class="mt-3 text-white/70">
            Protocoles, gouvernance, recherche et partenariats. L'accès à chaque document
            dépend de votre rôle — le badge de sensibilité indique le niveau de diffusion.
          </p>
        </div>
        <div
          class="glass-dark flex items-center gap-3 rounded-2xl px-4 py-3"
          aria-live="polite"
        >
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-teal-500">
            <Icon name="user" size={18} />
          </span>
          <div class="text-sm">
            <p class="text-white/60">Connecté en tant que</p>
            <p id="role-badge" class="font-semibold text-white">Professionnel de santé</p>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.65fr_1fr]">
        <!-- Liste des documents -->
        <section aria-labelledby="titre-docs">
          <h2 id="titre-docs" class="sr-only">Documents</h2>
          <ul class="space-y-3">
            {
              documents.map((doc) => (
                <li>
                  <article
                    class="ged-doc glass-dark group rounded-2xl p-4 transition-transform duration-200 data-[locked=false]:hover:-translate-y-0.5 sm:p-5"
                    data-access={JSON.stringify(doc.acces)}
                    data-titre={doc.titre}
                  >
                    <div class="flex items-start gap-4">
                      <span class="doc-icone mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-teal-500 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)]">
                        <Icon name={formatIcones[doc.format]} size={19} />
                      </span>
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <span
                            class:list={[
                              "rounded-full px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide ring-1",
                              badgeStyles[doc.sensibilite],
                            ]}
                          >
                            {SENSITIVITY_LABELS[doc.sensibilite]}
                          </span>
                          <span class="rounded-full bg-white/8 px-2 py-0.5 text-[0.65rem] font-medium text-white/60 ring-1 ring-white/10">
                            {CATEGORY_LABELS[doc.categorie]}
                          </span>
                          <span class="font-mono text-[0.65rem] uppercase text-white/40">
                            {doc.format} · v{doc.version}
                          </span>
                        </div>
                        <h3 class="mt-1.5 font-display text-[0.95rem] font-semibold leading-snug text-white">
                          {doc.titre}
                        </h3>
                        <p class="mt-1 text-xs text-white/50">
                          {doc.proprietaire} · mis à jour le {formatDate(new Date(doc.majLe))}
                        </p>
                      </div>
                      <div class="doc-etat shrink-0 self-center" aria-live="polite">
                        <button
                          type="button"
                          class="doc-ouvrir btn-3d inline-flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-medium text-white ring-1 ring-white/15 hover:bg-white/20"
                        >
                          <Icon name="eye" size={14} /> Consulter
                        </button>
                        <span class="doc-verrou hidden items-center gap-1.5 rounded-lg bg-danger/15 px-3 py-1.5 text-xs font-medium text-danger ring-1 ring-danger/30">
                          <Icon name="lock" size={13} /> Accès insuffisant
                        </span>
                      </div>
                    </div>
                  </article>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Colonne latérale -->
        <div class="space-y-6">
          <!-- Journal d'accès -->
          <section class="glass-dark rounded-2xl p-5" aria-labelledby="titre-journal">
            <h2 id="titre-journal" class="flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-wide text-white/90">
              <span class="text-teal-500"><Icon name="activity" size={16} /></span>
              Journal d'accès <span class="font-mono text-[0.6rem] normal-case text-white/40">(simulé)</span>
            </h2>
            <ul id="journal" class="mt-4 space-y-3 font-mono text-[0.72rem] leading-relaxed text-white/60">
              {
                auditLog.map((entry) => (
                  <li class="flex items-start gap-2">
                    <span
                      class:list={[
                        "mt-1 h-1.5 w-1.5 shrink-0 rounded-full",
                        entry.action === "acces_refuse" ? "bg-danger" : "bg-teal-500",
                      ]}
                      aria-hidden="true"
                    />
                    <span>
                      <span class="text-white/40">
                        {new Date(entry.horodatage).toLocaleString("fr-FR", {
                          day: "2-digit",
                          month: "2-digit",
                          hour: "2-digit",
                          minute: "2-digit",
                        })}
                      </span>
                      {" — "}
                      <span class="text-white/80">{ACTION_LABELS[entry.action]}</span>
                      {" · "}
                      {entry.acteur} ({ROLE_LABELS[entry.role]}) · {entry.cible}
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- Règles d'usage -->
          <section class="glass-dark rounded-2xl p-5" aria-labelledby="titre-regles">
            <h2 id="titre-regles" class="flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-wide text-white/90">
              <span class="text-teal-500"><Icon name="shield" size={16} /></span>
              Règles d'usage
            </h2>
            <ul class="mt-4 space-y-2.5 text-sm text-white/70">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-danger"><Icon name="x" size={15} /></span>
                Aucun document patient ni donnée de santé identifiante.
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-danger"><Icon name="x" size={15} /></span>
                Aucun RIB, mot de passe ou secret dans la bibliothèque.
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-teal-500"><Icon name="check" size={15} /></span>
                Chaque dépôt est versionné, attribué et tracé.
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-teal-500"><Icon name="check" size={15} /></span>
                Le niveau de sensibilité est obligatoire au dépôt.
              </li>
            </ul>
            <button
              type="button"
              id="btn-upload"
              class="btn-3d mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white/10 px-4 py-2.5 text-sm font-medium text-white ring-1 ring-white/15 hover:bg-white/20"
            >
              <Icon name="upload" size={16} /> Déposer un document
            </button>
            <p id="upload-note" class="mt-2 hidden text-xs text-warning" role="status">
              Dépôt désactivé en démonstration. En production : vérification du rôle,
              analyse antivirale, badge de sensibilité obligatoire et journalisation.
            </p>
          </section>

          <!-- Feuille de route V1.5 -->
          <section class="glass-dark rounded-2xl p-5">
            <h2 class="flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-wide text-white/90">
              <span class="text-teal-500"><Icon name="layers" size={16} /></span>
              GED V1.5 — prévu
            </h2>
            <ul class="mt-4 space-y-2 font-mono text-xs text-white/55">
              <li>→ Authentification Pro Santé Connect / SSO</li>
              <li>→ Contrôle d'accès serveur (RBAC) — Prisma / PostgreSQL</li>
              <li>→ Stockage objet chiffré compatible S3</li>
              <li>→ Journal d'audit immuable</li>
              <li>→ Recherche plein texte et cycle de validation</li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { ROLE_LABELS } from "@data/pro";
    import type { Role } from "@data/pro";

    const select = document.getElementById("role-select") as HTMLSelectElement | null;
    const badge = document.getElementById("role-badge");
    const journal = document.getElementById("journal");
    const docs = document.querySelectorAll<HTMLElement>(".ged-doc");

    function horodatage(): string {
      return new Date().toLocaleString("fr-FR", {
        day: "2-digit",
        month: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
      });
    }

    function journaliser(texte: string, refus: boolean): void {
      if (!journal) return;
      const li = document.createElement("li");
      li.className = "flex items-start gap-2";
      const dot = document.createElement("span");
      dot.className = `mt-1 h-1.5 w-1.5 shrink-0 rounded-full ${refus ? "bg-danger" : "bg-teal-500"}`;
      dot.setAttribute("aria-hidden", "true");
      const span = document.createElement("span");
      span.textContent = `${horodatage()} — ${texte}`;
      li.append(dot, span);
      journal.prepend(li);
      while (journal.children.length > 8) journal.lastElementChild?.remove();
    }

    function appliquerRole(role: Role): void {
      if (badge) badge.textContent = ROLE_LABELS[role];
      docs.forEach((doc) => {
        const acces = JSON.parse(doc.dataset.access ?? "[]") as Role[];
        const autorise = acces.includes(role);
        doc.dataset.locked = String(!autorise);
        doc.classList.toggle("opacity-60", !autorise);
        doc.querySelector(".doc-ouvrir")?.classList.toggle("hidden", !autorise);
        const verrou = doc.querySelector(".doc-verrou");
        verrou?.classList.toggle("hidden", autorise);
        verrou?.classList.toggle("inline-flex", !autorise);
      });
    }

    select?.addEventListener("change", () => {
      const role = select.value as Role;
      appliquerRole(role);
      journaliser(`Changement de rôle · ${ROLE_LABELS[role]} (simulation)`, false);
    });

    docs.forEach((doc) => {
      doc.querySelector(".doc-ouvrir")?.addEventListener("click", () => {
        journaliser(`Consultation · ${doc.dataset.titre ?? "document"} (démonstration)`, false);
      });
    });

    const btnUpload = document.getElementById("btn-upload");
    btnUpload?.addEventListener("click", () => {
      document.getElementById("upload-note")?.classList.remove("hidden");
      journaliser("Tentative de dépôt · refusée (environnement de démonstration)", true);
    });

    appliquerRole((select?.value as Role) ?? "professional");
  </script>
</BaseLayout>
