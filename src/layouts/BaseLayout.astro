---
import "@fontsource-variable/sora";
import { getCollection } from "astro:content";
import { withBase } from "@lib/paths";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";

import PublicHeader from "@components/PublicHeader.astro";
import PublicFooter from "@components/PublicFooter.astro";
import MobileActionBar from "@components/MobileActionBar.astro";
import { site } from "@data/site";

interface Props {
  title?: string;
  description?: string;
  /** Désactive l'indexation (pages techniques). */
  noindex?: boolean;
  /** Masque header/footer publics (espace pro). */
  chrome?: "public" | "pro";
}

const {
  title,
  description = site.description,
  noindex = false,
  chrome = "public",
} = Astro.props;

const slug = Astro.url.pathname.replace(import.meta.env.BASE_URL, "").replace(/^\/+|\/+$/g, "") || "accueil";
const editorial = (await getCollection("pages")).find(p => p.id === slug);
const actualTitle = editorial?.data.titre ?? title;
const actualDescription = editorial?.data.resume || description;
const pageTitle = actualTitle ? `${actualTitle} — ${site.nomCourt}` : `${site.nom}`;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url).href;
const prototype = process.env.PUBLIC_DEMO === '1';
const historical = !process.env.CMS_CONTENT_DIR;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  name: site.nom,
  url: site.url,
  description: site.description,
  areaServed: { "@type": "City", name: "Besançon" },
  email: site.contact.general,
};
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{pageTitle}</title>
    <meta name="description" content={actualDescription} />
    <link rel="canonical" href={canonical} />
    {(noindex || prototype || historical) && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nomCourt} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={actualDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#12324a" />
    {!prototype && !historical && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  </head>
  <body class="min-h-screen">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {(prototype || historical) && <aside id="prototype-info" aria-label="Version de démonstration" class="border-b border-blue-200 bg-blue-950 px-5 py-3 text-center text-sm text-white">
      <strong>{prototype ? 'Prototype Sant’Innovation — présentation à l’équipe' : 'Version de démonstration non validée'}</strong>
      <p>{prototype ? 'Les professionnels, lieux et actualités sont fictifs. Aucun rendez-vous ni demande de soins sur ce prototype.' : 'Informations historiques non validées. Cette version ne doit pas servir à organiser des soins.'}</p>
    </aside>}
    {chrome === "public" && <PublicHeader />}
    <main id="contenu" class:list={[chrome === "public" && "pb-20 sm:pb-0"]}>
      <slot />
    </main>
    {chrome === "public" && <PublicFooter />}
    {chrome === "public" && <MobileActionBar />}
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
